---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Secure Share"
  description="Secure Share is the Lowcountry Digital Works entry point for temporary credentials, sensitive values, or specifically requested non-regulated files."
  robots="noindex,noarchive"
>
  <section class="page-hero">
    <div class="container readable">
      <p class="eyebrow">Secure Share</p>
      <h1>Share requested sensitive information.</h1>
      <p class="lede">Use Secure Share only when Lowcountry Digital Works has specifically asked you to share a temporary credential, sensitive value, or non-regulated file.</p>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container grid grid--2">
      <article class="card card--accent">
        <p class="card__kicker">Use Secure Share for</p>
        <h2>Temporary, requested information</h2>
        <ul class="card__list">
          <li>Temporary credentials requested by Lowcountry Digital Works.</li>
          <li>Sensitive values requested for a specific task.</li>
          <li>Non-regulated files specifically requested by Lowcountry Digital Works.</li>
        </ul>
        <div class="meta-note"><strong>Temporary exchange only</strong><p>Secure Share is not intended as permanent storage or a general file drop.</p></div>
      </article>

      <article class="card card--accent">
        <p class="card__kicker">Do not share</p>
        <h2>Restricted or unrelated information</h2>
        <ul class="card__list">
          <li>Medical records or protected health information (PHI).</li>
          <li>Controlled Unclassified Information (CUI).</li>
          <li>Payment-card information.</li>
          <li>Social Security numbers, driver's license or passport numbers, or other government identifiers.</li>
          <li>Any other regulated data.</li>
          <li>Files or information unrelated to a Lowcountry Digital Works request.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container readable">
      <p class="eyebrow">Attachment limits</p>
      <h2>Before you continue</h2>
      <ul class="check-list">
        <li>Maximum 10 files per submission.</li>
        <li>Maximum 500 MB per file.</li>
      </ul>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container readable">
      <p class="eyebrow">Continue securely</p>
      <h2>Ready to share what LDW requested?</h2>
      <p class="lede">You'll continue to the Secure Share portal.</p>
      <div class="actions">
        <a class="button" href="/share/continue">Continue to Secure Share</a>
      </div>
    </div>
  </section>
</BaseLayout>
