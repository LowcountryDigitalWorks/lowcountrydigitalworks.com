---
import BaseLayout from '../layouts/BaseLayout.astro';
import work from '../data/work.json';
---
<BaseLayout title="Work" description="Selected Lowcountry Digital Works systems and products with clear status, evidence, and boundaries.">
  <section class="page-hero">
    <div class="container readable">
      <p class="eyebrow">{work.hero.eyebrow}</p>
      <h1>{work.hero.title}</h1>
      <p class="lede">{work.hero.lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container work-list work-list--large">
      {work.projects.map((project) => (
        <article class="work-row work-row--large work-row--visual">
          {project.thumbnail && (
            <a class="work-row__visual" href={`/work/${project.slug}/`} aria-label={`View ${project.name} project details`}>
              <img
                src={project.thumbnail.src}
                alt=""
                width={project.thumbnail.width}
                height={project.thumbnail.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          <div class="work-row__content">
            <div class="work-row__meta">
              <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
              <span>{project.type}</span>
            </div>
            <div>
              <h2>{project.name}</h2>
              <p class="lede lede--compact">{project.purpose}</p>
              <p>{project.whyItMatters}</p>
              <ul class="evidence-inline">{project.evidence.slice(0, 3).map((item) => <li>{item}</li>)}</ul>
            </div>
            <a class="work-row__link" href={`/work/${project.slug}/`}>Project details →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.technology.eyebrow}</p>
        <h2>{work.technology.title}</h2>
        <p class="lede">{work.technology.lede}</p>
      </div>
      <div class="technology-grid">
        {work.technology.items.map((technology) => (
          <article class="technology-card">
            <img src={technology.icon} alt="" width="40" height="40" loading="lazy" />
            <div><h3>{technology.name}</h3><p>{technology.description}</p></div>
          </article>
        ))}
      </div>
      <p class="trademark-note">{work.technology.trademarkNote}</p>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container readable">
      <p class="eyebrow">{work.principle.eyebrow}</p>
      <h2>{work.principle.title}</h2>
      <p class="lede">{work.principle.body}</p>
      <div class="actions"><a class="button button--secondary" href="/connect/">Discuss a project</a></div>
    </div>
  </section>
</BaseLayout>
