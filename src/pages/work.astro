---
import BaseLayout from '../layouts/BaseLayout.astro';
import work from '../data/work.json';
---
<BaseLayout title="Work" description="Permissioned client work and Lowcountry Digital Works systems with plain-language context, live proof, current maturity, and explicit boundaries.">
  <section class="page-hero page-hero--warm">
    <div class="container readable">
      <p class="eyebrow">{work.hero.eyebrow}</p>
      <h1>{work.hero.title}</h1>
      <p class="lede">{work.hero.lede}</p>
      <div class="actions">
        <a class="button" href="#client-work">See the work</a>
        <a class="text-link" href="/connect/">Talk through a similar problem →</a>
      </div>
    </div>
  </section>

  <section class="section" id="client-work" data-client-work>
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.clientWork.eyebrow}</p>
        <h2>{work.clientWork.title}</h2>
        <p class="lede">{work.clientWork.lede}</p>
      </div>

      <div class="portfolio-grid portfolio-grid--work">
        {work.clientWork.items.map((client) => (
          <article class="portfolio-card portfolio-card--work portfolio-card--proof" data-client-proof={client.name}>
            <div class="portfolio-card__body">
              <div class="work-row__meta">
                <span class="status-pill status-pill--live">Client work</span>
                <span>{client.type}</span>
              </div>
              <h3>{client.name}</h3>
              <p class="lede lede--compact">{client.context}</p>
              <div class="portfolio-card__context">
                <p><strong>LDW work</strong>{client.work}</p>
                <p><strong>Live proof</strong>{client.proof}</p>
                <p class="portfolio-card__boundary"><strong>Boundary</strong>{client.boundary}</p>
              </div>
              <a class="text-link" href={client.href} rel="noopener noreferrer">Visit the live site →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--warm" id="internal-proof" data-internal-proof>
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.internalProof.eyebrow}</p>
        <h2>{work.internalProof.title}</h2>
        <p class="lede">{work.internalProof.lede}</p>
      </div>

      <div class="portfolio-grid portfolio-grid--work">
        {work.projects.map((project) => (
          <article class="portfolio-card portfolio-card--work portfolio-card--proof">
            {project.thumbnail && (
              <a class="portfolio-card__visual" href={`/work/${project.slug}/`} aria-label={`View ${project.name} project details`}>
                <img
                  src={project.thumbnail.src}
                  alt=""
                  width={project.thumbnail.width}
                  height={project.thumbnail.height}
                  decoding="async"
                />
              </a>
            )}
            <div class="portfolio-card__body">
              <div class="work-row__meta">
                <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
                <span>{project.type}</span>
              </div>
              <h3>{project.name}</h3>
              <p class="lede lede--compact">{project.homeSummary ?? project.purpose}</p>
              <div class="portfolio-card__context">
                <p><strong>Why this matters</strong>{project.workWhy}</p>
                <p class="portfolio-card__boundary"><strong>Current boundary</strong>{project.cardBoundary}</p>
              </div>
              <a class="text-link" href={`/work/${project.slug}/`}>See evidence, maturity & boundaries →</a>
            </div>
          </article>
        ))}
      </div>

      <p class="portfolio-detail-note">These are LDW-owned systems and internal proof, not claims about completed client deployments.</p>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container readable">
      <p class="eyebrow">{work.principle.eyebrow}</p>
      <h2>{work.principle.title}</h2>
      <p class="lede">{work.principle.body}</p>
      <div class="actions">
        <a class="button button--secondary" href="/approach/">See how LDW approaches the work</a>
        <a class="text-link text-link--light" href="/connect/">Discuss a similar problem →</a>
      </div>
    </div>
  </section>

  <section class="section section--warm work-tools">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.technology.eyebrow}</p>
        <h2>{work.technology.title}</h2>
        <p class="lede">{work.technology.lede}</p>
      </div>
      <div class="technology-compact" aria-label="Examples of tools used in LDW delivery">
        {work.technology.items.map((technology) => (
          <article class="technology-compact__item">
            <img src={technology.icon} alt="" width="32" height="32" loading="lazy" />
            <div><h3>{technology.name}</h3><p>{technology.description}</p></div>
          </article>
        ))}
      </div>
      <p class="trademark-note">{work.technology.trademarkNote}</p>
    </div>
  </section>
</BaseLayout>
