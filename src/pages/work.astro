---
import BaseLayout from '../layouts/BaseLayout.astro';
import work from '../data/work.json';
---
<BaseLayout title="Work" description="Selected Lowcountry Digital Works website, application, and internal service-enabling work with explicit live, development, and internal status.">
  <section class="page-hero page-hero--compact">
    <div class="container readable">
      <p class="eyebrow">{work.hero.eyebrow}</p>
      <h1>{work.hero.title}</h1>
      <p class="lede">{work.hero.lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container project-list">
      {work.projects.map((project) => (
        <article class="project-row">
          <div class="project-row__visual">
            {project.image ? (
              <img src={project.image} alt={project.imageAlt} width="1440" height="1000" loading="lazy" />
            ) : (
              <div class="evidence-visual" aria-label={project.name + ' status'}>
                <span>{project.status}</span>
                <strong>{project.type}</strong>
                <small>{project.evidence[0]}</small>
              </div>
            )}
          </div>
          <div class="project-row__copy">
            <div class="work-card__meta">
              <span class={'status-pill ' + (project.status === 'Live' ? 'status-pill--live' : '')}>{project.status}</span>
              <span>{project.type}</span>
            </div>
            <h2>{project.name}</h2>
            <p class="lede">{project.description}</p>
            <p>{project.purpose}</p>
            <a class="text-link" href={'/work/' + project.slug + '/'}>View project evidence & boundaries</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.technology.eyebrow}</p>
        <h2>{work.technology.title}</h2>
        <p class="lede">{work.technology.lede}</p>
      </div>
      <div class="technology-grid">
        {work.technology.items.map((technology) => (
          <article class="technology-card">
            <img src={technology.icon} alt="" width="40" height="40" loading="lazy" />
            <div><h3>{technology.name}</h3><p>{technology.description}</p></div>
          </article>
        ))}
      </div>
      <p class="trademark-note">{work.technology.trademarkNote}</p>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container split-callout">
      <div><p class="eyebrow">{work.principle.eyebrow}</p><h2>{work.principle.title}</h2><p class="lede">{work.principle.body}</p></div>
      <div class="actions"><a class="button button--secondary" href="/connect/">Discuss a project</a></div>
    </div>
  </section>
</BaseLayout>
