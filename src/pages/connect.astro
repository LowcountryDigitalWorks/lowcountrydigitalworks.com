---
import { ldw } from '../lib/analytics-config.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../data/contact.json';
import home from '../data/home.json';
import Icon from '../components/Icon.astro';
import RequestFlowSteps from '../components/RequestFlowSteps.astro';
import TownGroups from '../components/TownGroups.astro';

// k5e: the card's QR is the owner-supplied first-party asset (qr-kit 5038c628…, 41x41 modules incl. a 4-module white quiet zone) and
// encodes only the canonical /connect/ URL, no vCard content and no tracking parameter.
const qr = {
  src: '/r5/assets/qr/ldw-connect-qr.svg',
  url: 'https://lowcountrydigitalworks.com/connect/',
  host: 'lowcountrydigitalworks.com',
  path: '/connect/',
  alt: 'QR code for lowcountrydigitalworks.com/connect/',
};
---
<BaseLayout title="Connect" description="Connect directly with Eddie Gugino at Lowcountry Digital Works by text, phone, email, contact card, or an optional guided project form.">
  <section class="page-hero page-hero--fit" aria-labelledby="connect-heading">
    <div class="container">
      <div class="page-hero-plate">
        <p class="eyebrow">{contact.hero.eyebrow}</p>
        <h1 id="connect-heading">{contact.hero.title}</h1>
        <p class="lede">{contact.hero.lede}</p>
        <p>Founder · Beaufort, South Carolina</p>
      </div>
    </div>
  </section>

  <section class="section section--plain connect-page">
    <div class="container">
      <div class="connect-split">
        <article class="biz-card biz-card--tidal" aria-label="Contact card for Eddie Gugino">
          <div class="biz-card__banner">
            <img class="biz-card__logo" src="/brand/logo/lowcountry-digital-works-logo-horizontal-white.svg" alt="Lowcountry Digital Works" width="312" height="88" />
            <p class="biz-card__tagline">Let’s connect.</p>
          </div>
          <div class="biz-card__body">
            <p class="biz-card__name">{contact.founder.name}</p>
            <p class="biz-card__title">{contact.founder.role} · Lowcountry Digital Works LLC</p>
            <p class="biz-card__place">Beaufort, South Carolina</p>
            <a class="button biz-card__save" href="/eddie-gugino-lowcountry-digital-works.vcf#on-card" download {...ldw('contact_card_download', { placement: 'connect_card' })}>Save contact</a>
            <nav class="biz-card__actions" aria-label="Contact options">
              <a class="biz-card__action" href={`sms:${contact.phone.number}`} {...ldw('contact_method_click', { method: 'sms', placement: 'connect_actions' })}><Icon name="message" size={20} /><span>Text Eddie</span></a>
              <a class="biz-card__action" href={`tel:${contact.phone.number}`} {...ldw('contact_method_click', { method: 'phone', placement: 'connect_actions' })}><Icon name="phone" size={20} /><span>Call Eddie</span></a>
              <a class="biz-card__action" href={`mailto:${contact.email.address}`} {...ldw('contact_method_click', { method: 'email', placement: 'connect_actions' })}><Icon name="mail" size={20} /><span>Email Eddie</span></a>
            </nav>
            <div class="biz-card__qr biz-card__qr--wide">
              <span class="biz-card__qr-plate"><img src={qr.src} alt={qr.alt} width="176" height="176" decoding="async" /></span>
              <p class="biz-card__qr-copy"><strong>Scan with your phone</strong><a href={qr.url}>{qr.host}<wbr />{qr.path}</a></p>
            </div>
            <details class="biz-card__qr-narrow">
              <summary>Show QR</summary>
              <div class="biz-card__qr">
                <span class="biz-card__qr-plate"><img src={qr.src} alt={qr.alt} width="176" height="176" loading="lazy" decoding="async" /></span>
                <p class="biz-card__qr-copy"><strong>Scan with your phone</strong><a href={qr.url}>{qr.host}<wbr />{qr.path}</a></p>
              </div>
            </details>
            <hr class="biz-card__rule" />
            <p class="biz-card__line">{contact.phone.display}</p>
            <p class="biz-card__line">{contact.email.address.split('@')[0]}<wbr />@{contact.email.address.split('@')[1]}</p>
            <p class="biz-card__line">lowcountrydigitalworks.com</p>
          </div>
        </article>
        <div>
          <article class="message-card connect-reassurance">
            <p class="eyebrow">Easy first step</p>
            <h2>{contact.quickStart.title}</h2>
            <p>{contact.quickStart.body}</p>
          </article>
          <div class="section-heading">
            <p class="eyebrow">What happens next</p>
            <h2>How a first note moves.</h2>
            <p class="lede">Text, call, email, or the optional guided form—all ordinary channels, read by a person before any scope is written.</p>
          </div>
          <RequestFlowSteps layout="2x2" carousel id="connect-steps" />
        </div>
      </div>

      <section class="connect-area" aria-labelledby="connect-area-title">
        <p class="eyebrow">Local service area</p>
        <h2 id="connect-area-title">Based in Beaufort, working across the Lowcountry.</h2>
        <p class="connect-area__lede">Towns are listed equally, grouped by which side of the Broad River they sit on.</p>
        <TownGroups id="connect-towns" north={home.serviceAreas.northCommunities} south={home.serviceAreas.southOfBroad.rows.flat()} />
        <p class="town-note">Hilton Head by request only.</p>
      </section>

      <section class="connect-reassurance connect-discovery" aria-labelledby="guided-discovery-title">
        <p class="eyebrow">{contact.discovery.eyebrow}</p>
        <h2 id="guided-discovery-title">{contact.discovery.title}</h2>
        <p>{contact.discovery.body}</p>
        <div class="connect-discovery__handoff">
          <p class="small"><strong>Hosted by {contact.discovery.provider}.</strong> {contact.discovery.privacyText} <a href={contact.discovery.privacyHref}>Read the LDW Privacy Notice.</a></p>
          <p class="small">{contact.discovery.safetyText}</p>
          <p class="small"><strong>{contact.discovery.expectationText}</strong></p>
        </div>
        <div class="actions">
          <a class="button button--secondary" href={contact.discovery.href} rel="noopener noreferrer">{contact.discovery.label}</a>
        </div>
      </section>

      <div class="connect-links">
        <a href="/services/">Find a service →</a>
        <a href="/work/">See how LDW works →</a>
        {contact.socials.map((social) => (
          <a class="icon-link" href={social.href} rel="me noopener noreferrer">
            {social.name === 'LinkedIn' ? (
              <img src="/brand/social/linkedin/LI-In-Bug.png" alt="" width="20" height="18" decoding="async" />
            ) : (
              <Icon name={social.name === 'Facebook' ? 'facebook' : 'x'} size={18} />
            )}
            <span>{social.name}</span>
          </a>
        ))}
      </div>

      <p class="connect-note">For passwords, MFA or recovery codes, private keys, API tokens, payment-card information, PHI, or other sensitive secrets, do not use ordinary email or text. Use a secure method specifically provided for the engagement.</p>
    </div>
  </section>
  <script is:inline src="/r5/site-carousel.js" defer></script>
</BaseLayout>
