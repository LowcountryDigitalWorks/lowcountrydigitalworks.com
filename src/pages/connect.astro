---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---
<BaseLayout title="Connect" description="Connect with Eddie Gugino, founder of Lowcountry Digital Works, by text, phone, email, or verified social profile.">
  <section class="connect-shell">
    <div class="connect-card">
      <img class="connect-mark" src="/brand/logo/lowcountry-digital-works-mark.svg" alt="" width="96" height="96" />
      <p class="eyebrow">Lowcountry Digital Works</p>
      <h1>{site.business.founder.name}</h1>
      <p class="connect-role">{site.business.founder.title}</p>
      <p class="lede">Practical websites, automation, business systems, digital ownership, and technology consulting—built to stay understandable and remain yours.</p>

      <div class="connect-actions">
        <a class="button" href={'sms:' + site.business.phone}>Text {site.business.phoneDisplay}</a>
        <a class="button button--secondary" href={'tel:' + site.business.phone}>Call</a>
        <a class="button button--secondary" href={'mailto:' + site.business.email}>Email</a>
      </div>

      <div class="connect-links" aria-label="Lowcountry Digital Works links">
        <a href="/">Website</a>
        <a href="/services/">Services</a>
        <a href="/work/">Work</a>
        <a href="/lowcountry-digital-works.vcf" download>Save contact</a>
      </div>

      <div class="social-links" aria-label="Verified social profiles">
        {site.business.social.map((social) => <a href={social.url} rel="me noopener noreferrer">{social.name}</a>)}
      </div>

      <p class="connect-note">Please do not send passwords, MFA/recovery codes, payment-card data, PHI, or other sensitive secrets through ordinary email, text, or social messaging.</p>
    </div>
  </section>
</BaseLayout>
