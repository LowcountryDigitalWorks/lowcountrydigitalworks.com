---
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../data/contact.json';
import home from '../data/home.json';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Connect" description="Connect directly with Eddie Gugino at Lowcountry Digital Works by text, phone, email, contact card, or an optional guided project form.">
  <section class="page-hero" aria-labelledby="connect-heading">
    <div class="container">
      <div class="page-hero-plate">
        <p class="eyebrow">{contact.hero.eyebrow}</p>
        <h1 id="connect-heading">{contact.hero.title}</h1>
        <p class="lede">{contact.hero.lede}</p>
        <p>Founder · Beaufort, South Carolina</p>
      </div>
    </div>
  </section>

  <section class="section section--plain connect-page">
    <div class="container">
      <div class="connect-split">
        <article class="biz-card biz-card--tidal" aria-label="Contact card for Eddie Gugino">
          <div class="biz-card__banner">
            <img class="biz-card__logo" src="/brand/logo/lowcountry-digital-works-logo-horizontal-white.svg" alt="Lowcountry Digital Works" width="312" height="88" />
            <p class="biz-card__tagline">Let’s connect.</p>
          </div>
          <div class="biz-card__body">
            <span class="biz-card__avatar" aria-hidden="true">EG</span>
            <p class="biz-card__name">Eddie Gugino</p>
            <p class="biz-card__title">Founder · Lowcountry Digital Works LLC</p>
            <p class="biz-card__place">Beaufort, South Carolina</p>
            <a class="button biz-card__save" href="/eddie-gugino-lowcountry-digital-works.vcf#on-card" download>Save contact</a>
            <hr class="biz-card__rule" />
            <p class="biz-card__line">{contact.phone.display}</p>
            <p class="biz-card__line">{contact.email.address}</p>
            <p class="biz-card__line">lowcountrydigitalworks.com</p>
          </div>
        </article>
        <div>
          <article class="message-card connect-reassurance">
            <p class="eyebrow">Easy first step</p>
            <h2>{contact.quickStart.title}</h2>
            <p>{contact.quickStart.body}</p>
          </article>
          <div class="section-heading">
            <p class="eyebrow">What happens next</p>
            <h2>How a first note moves.</h2>
          </div>
          <picture>
            <source media="(max-width: 899px)" srcset="/r5/assets/diagrams/how-a-request-moves-phone.svg" />
            <img class="diagram diagram--lg" src="/r5/assets/diagrams/how-a-request-moves-lg.svg" alt="Illustration: how a first note moves from you to Eddie, who reviews and replies." width="680" height="420" loading="lazy" />
          </picture>
          <p class="caption">Illustration: how a first note moves</p>
        </div>
      </div>

      <div class="connect-actions action-grid action-grid--under" aria-label="Contact options">
        <a class="connect-action connect-action--primary" href={`sms:${contact.phone.number}`}>
          <span class="connect-action__icon"><Icon name="message" size={22} /></span>
          <span class="connect-action__copy"><span>Text Eddie</span><strong>{contact.phone.display}</strong><small>Send a short note</small></span>
        </a>
        <a class="connect-action" href={`tel:${contact.phone.number}`}>
          <span class="connect-action__icon"><Icon name="phone" size={22} /></span>
          <span class="connect-action__copy"><span>Call Eddie</span><strong>{contact.phone.display}</strong><small>Talk it through</small></span>
        </a>
        <a class="connect-action" href={`mailto:${contact.email.address}`}>
          <span class="connect-action__icon"><Icon name="mail" size={22} /></span>
          <span class="connect-action__copy"><span>Email Eddie</span><strong>{contact.email.address}</strong><small>Share a little context</small></span>
        </a>
        <a class="connect-action" href="/eddie-gugino-lowcountry-digital-works.vcf" download>
          <span class="connect-action__icon"><Icon name="contact" size={22} /></span>
          <span class="connect-action__copy"><span>Save Eddie</span><strong>Contact card</strong><small>Keep the details handy</small></span>
        </a>
      </div>

      <section class="connect-area" aria-labelledby="connect-area-title">
        <p class="eyebrow">Local service area</p>
        <h2 id="connect-area-title">Based in Beaufort, working across the Lowcountry.</h2>
        <p class="connect-area__lede">Towns are listed equally, grouped by which side of the Broad River they sit on. Hilton Head by request only.</p>
        <div class="connect-area__groups town-groups">
          <div>
            <h3>North of the Broad River</h3>
            <ul class="town-list" aria-label="Towns north of the Broad River">
              {home.serviceAreas.northCommunities.map((area) => <li>{area}</li>)}
            </ul>
          </div>
          <div>
            <h3>South of the Broad River</h3>
            {home.serviceAreas.southOfBroad.rows.map((row) => (
              <ul class="town-list town-list--south" aria-label="Towns south of the Broad River">
                {row.map((area) => <li>{area}</li>)}
              </ul>
            ))}
          </div>
        </div>
      </section>

      <section class="connect-reassurance connect-discovery" aria-labelledby="guided-discovery-title">
        <p class="eyebrow">{contact.discovery.eyebrow}</p>
        <h2 id="guided-discovery-title">{contact.discovery.title}</h2>
        <p>{contact.discovery.body}</p>
        <div class="connect-discovery__handoff">
          <p class="small"><strong>Hosted by {contact.discovery.provider}.</strong> {contact.discovery.privacyText} <a href={contact.discovery.privacyHref}>Read the LDW Privacy Notice.</a></p>
          <p class="small">{contact.discovery.safetyText}</p>
          <p class="small"><strong>{contact.discovery.expectationText}</strong></p>
        </div>
        <div class="actions">
          <a class="button button--secondary" href={contact.discovery.href} rel="noopener noreferrer">{contact.discovery.label}</a>
        </div>
      </section>

      <div class="connect-links">
        <a href="/services/">Find a service →</a>
        <a href="/work/">See how LDW works →</a>
        {contact.socials.map((social) => (
          <a class="icon-link" href={social.href} rel="me noopener noreferrer">
            {social.name === 'LinkedIn' ? (
              <img src="/brand/social/linkedin/LI-In-Bug.png" alt="" width="20" height="18" decoding="async" />
            ) : (
              <Icon name={social.name === 'Facebook' ? 'facebook' : 'x'} size={18} />
            )}
            <span>{social.name}</span>
          </a>
        ))}
      </div>

      <p class="connect-note">For passwords, MFA or recovery codes, private keys, API tokens, payment-card information, PHI, or other sensitive secrets, do not use ordinary email or text. Use a secure method specifically provided for the engagement.</p>
    </div>
  </section>
</BaseLayout>
