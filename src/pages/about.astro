---
import BaseLayout from '../layouts/BaseLayout.astro';
import about from '../data/about.json';
---
<BaseLayout title="About" description="About Lowcountry Digital Works, a small digital services business being established in South Carolina's Lowcountry.">
  <section class="page-hero"><div class="container readable"><p class="eyebrow">{about.hero.eyebrow}</p><h1>{about.hero.title}</h1><p class="lede">{about.hero.lede}</p></div></section>

  <section class="section"><div class="container grid grid--2">{about.principles.map((item) => <article class="card"><h2>{item.title}</h2><p>{item.description}</p></article>)}</div></section>

  <section class="section section--navy">
    <div class="container principle">
      <div><p class="eyebrow">{about.whySmall.eyebrow}</p><h2>{about.whySmall.title}</h2><p class="lede">{about.whySmall.body}</p></div>
      <ul class="principle__list">{about.whySmall.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section section--warm"><div class="container readable"><p class="eyebrow">{about.fit.eyebrow}</p><h2>{about.fit.title}</h2><p class="lede">{about.fit.body}</p><div class="actions"><a class="button" href="/contact/">Start a conversation</a></div></div></section>
</BaseLayout>
