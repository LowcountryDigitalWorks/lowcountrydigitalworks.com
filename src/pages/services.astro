---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import services from '../data/services.json';

// Plans: everything every plan shares is stated once above the cards; each card keeps only what is its own.
const planSet = services.websitePlans;
const sentences = planSet.quoteNote.split(/(?<=\.)\s+/);
const sharedExclusion = /website care|care or marketing|ranking|seo|marketing|advertising/i;
const sharedGuarantee = planSet.plans[0].notIncluded.find((item) => /guarantee/i.test(item));
const planWide = [
  sentences[0],
  sentences.slice(1).join(' '),
  planSet.ownershipNote,
  sharedGuarantee ? `No plan includes ${sharedGuarantee.charAt(0).toLowerCase()}${sharedGuarantee.slice(1)}.` : null,
].filter(Boolean);
const ladder = planSet.plans.filter((plan) => plan.id !== 'custom');
const customPlan = planSet.plans.find((plan) => plan.id === 'custom');
const ownLimits = (plan) => plan.notIncluded.filter((item) => !sharedExclusion.test(item));
---
<BaseLayout
  title="Website & Automation Services in Beaufort, SC"
  description="Website projects and care, business systems and automation, digital ownership and platform administration, and technology consulting from Lowcountry Digital Works."
>
  <section class="page-hero page-hero--fit" aria-labelledby="services-heading">
    <div class="container">
      <div class="page-hero-plate">
        <p class="eyebrow">Services and Plans</p>
        <h1 id="services-heading">{services.page.title}</h1>
        <p class="lede">{services.page.lede}</p>
        <div class="actions">
          <a class="button hero-start" href="#start">Find your starting point</a>
          <a class="text-link" href="#plans">See website plans</a>
        </div>
      </div>
      <a class="hero-next" href="#start-mobile">Start from the problem <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="router-section section section--plain services-r5-mobile" id="start-mobile" aria-labelledby="router-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Start from the problem</p>
        <h2 id="router-heading">Which of these sounds most like what is happening now?</h2>
        <p class="lede">Pick the situation that feels closest. You do not need the technical name for it.</p>
      </div>
      <div class="router-grid">
        <details class="router-tile">
          <summary>
            <span class="router-tile__visual"><picture>
              <source type="image/avif" srcset="/r5/assets/clients/east-coast-foam-thumb.avif" />
              <source type="image/webp" srcset="/r5/assets/clients/east-coast-foam-thumb.webp" />
              <img src="/r5/assets/clients/east-coast-foam-thumb.jpg" alt="" width="390" height="220" loading="lazy" />
            </picture></span>
            <span class="router-tile__text">
              <span class="choice__num" aria-hidden="true">01</span>
              <span class="choice__title">The public website feels dated or unclear</span>
              <span class="example-label">Example: live client site</span>
            </span>
          </summary>
          <div class="router-tile__panel">
            <p>What LDW looks at first: how a visitor finds a service and a next step.</p>
            <a class="text-link" href="/services/websites/">See this path →</a>
          </div>
        </details>
        <details class="router-tile">
          <summary>
            <span class="router-tile__visual"><picture>
              <source type="image/avif" srcset="/r5/assets/internal/document-control-workflow-crop.avif" />
              <source type="image/webp" srcset="/r5/assets/internal/document-control-workflow-crop.webp" />
              <img loading="lazy" src="/r5/assets/internal/document-control-workflow-crop.jpg" alt="" width="780" height="440" />
            </picture></span>
            <span class="router-tile__text">
              <span class="choice__num" aria-hidden="true">02</span>
              <span class="choice__title">Repeating daily tasks by hand</span>
              <span class="example-label">Internal tool · synthetic / test-only</span>
            </span>
          </summary>
          <div class="router-tile__panel">
            <p>What LDW looks at first: where information moves by hand today.</p>
            <a class="text-link" href="/services/business-systems-automation/">See this path →</a>
          </div>
        </details>
        <details class="router-tile router-tile--diagram">
          <summary>
            <span class="router-tile__visual"><img loading="lazy" src="/r5/assets/diagrams/who-holds-the-keys-thumb.svg" alt="" width="200" height="100" /></span>
            <span class="router-tile__text">
              <span class="choice__num" aria-hidden="true">03</span>
              <span class="choice__title">We are not sure who owns the accounts</span>
              <span class="example-label">Diagram: example setup</span>
            </span>
          </summary>
          <div class="router-tile__panel">
            <p>What LDW looks at first: domain, DNS, hosting, email, and logins.</p>
            <a class="text-link" href="/services/digital-ownership-platform-administration/">See this path →</a>
          </div>
        </details>
        <details class="router-tile router-tile--diagram">
          <summary>
            <span class="router-tile__visual"><img loading="lazy" src="/r5/assets/diagrams/current-setup-map-thumb.svg" alt="" width="200" height="100" /></span>
            <span class="router-tile__text">
              <span class="choice__num" aria-hidden="true">04</span>
              <span class="choice__title">The current setup is hard to see clearly</span>
              <span class="example-label">Diagram: example small-business setup</span>
            </span>
          </summary>
          <div class="router-tile__panel">
            <p>What LDW looks at first: website, email, booking, payments, and files.</p>
            <a class="text-link" href="/services/technology-consulting/">See this path →</a>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="section section--plain" id="start">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Four services</p>
        <h2>Each service, shown with the work it produces.</h2>
      </div>
      <div class="service-hub-grid service-choice-list service-choice-list--hub">
        {services.families.map((family, index) => (
          <article class="chapter service-hub-card service-family service-choice service-hub-card--contained">
            <div class="chapter__visual">
              {index === 0 && (
                <>
                  <picture>
                    <source type="image/avif" media="(max-width: 899px)" srcset="/r5/assets/clients/east-coast-foam-390.avif" />
                    <source type="image/webp" media="(max-width: 899px)" srcset="/r5/assets/clients/east-coast-foam-390.webp" />
                    <source media="(max-width: 899px)" srcset="/r5/assets/clients/east-coast-foam-390.jpg" />
                    <source type="image/avif" srcset="/r5/assets/clients/east-coast-foam-1280.avif" />
                    <source type="image/webp" srcset="/r5/assets/clients/east-coast-foam-1280.webp" />
                    <img src="/r5/assets/clients/east-coast-foam-1280.jpg" alt="East Coast Foam public website. Example: live client site." width="1280" height="800" loading="lazy" />
                  </picture>
                  <p class="example-label">Example: live client site</p>
                </>
              )}
              {index === 1 && (
                <>
                  <picture>
                    <source type="image/avif" media="(max-width: 899px)" srcset="/r5/assets/internal/document-control-workflow-crop.avif" />
                    <source type="image/webp" media="(max-width: 899px)" srcset="/r5/assets/internal/document-control-workflow-crop.webp" />
                    <source media="(max-width: 899px)" srcset="/r5/assets/internal/document-control-workflow-crop.jpg" />
                    <source type="image/avif" srcset="/r5/assets/internal/document-control-workflow.avif" />
                    <source type="image/webp" srcset="/r5/assets/internal/document-control-workflow.webp" />
                    <img src="/r5/assets/internal/document-control-workflow.jpg" alt="Document Control workflow, synthetic test data." width="1440" height="900" loading="lazy" />
                  </picture>
                  <p class="maturity">Active development · not a production customer deployment</p>
                </>
              )}
              {index === 2 && (
                <>
                  <picture>
                    <source media="(max-width: 899px)" srcset="/r5/assets/diagrams/who-holds-the-keys-phone.svg" />
                    <img class="diagram" src="/r5/assets/diagrams/who-holds-the-keys.svg" alt="Diagram: example setup — who holds the keys." width="960" height="280" loading="lazy" />
                  </picture>
                  <p class="caption">Diagram: example setup</p>
                </>
              )}
              {index === 3 && (
                <>
                  <picture>
                    <source media="(max-width: 899px)" srcset="/r5/assets/diagrams/current-setup-map-phone.svg" />
                    <img class="diagram" src="/r5/assets/diagrams/current-setup-map.svg" alt="Diagram: example small-business setup." width="960" height="280" loading="lazy" />
                  </picture>
                  <div class="tool-row">
                    <img src="/technology/github.svg" alt="GitHub" width="36" height="36" />
                    <img src="/technology/cloudflare.svg" alt="Cloudflare" width="36" height="36" />
                    <img src="/technology/astro.svg" alt="Astro" width="36" height="36" />
                    <img src="/technology/typescript.svg" alt="TypeScript" width="36" height="36" />
                    <img src="/technology/python.svg" alt="Python" width="36" height="36" />
                  </div>
                  <p class="caption">Marks identify tools LDW uses. They do not imply endorsement by those companies.</p>
                </>
              )}
            </div>
            <div class="service-hub-card__body">
              <a class="service-hub-card__surface" href={family.primaryHref}>
                <div class="service-hub-card__index service-family__index">
                  <span class="service-hub-card__number" aria-hidden="true">{family.number}</span>
                  <span class="service-hub-card__icon service-family__icon"><Icon name={family.icon} size={28} /></span>
                </div>
                <p class="card__kicker card__eyebrow">{family.kicker}</p>
                <p class="service-choice__prompt">{family.prompt}</p>
                <h2 class="service-hub-card__title">{family.name}</h2>
                <p>{family.description}</p>
                <span class="service-hub-card__cta">{family.primaryLabel} →</span>
              </a>
              {family.secondaryHref && (
                <div class="service-hub-card__footer situation__links">
                  <a class="text-link" href={family.secondaryHref}>{family.secondaryLabel} →</a>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--plain plans" id="plans" aria-labelledby="website-plans-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{planSet.eyebrow}</p>
        <h2 id="website-plans-title">{planSet.title}</h2>
        <p class="lede">{planSet.intro}</p>
      </div>

      <ul class="plan-strip" aria-label="True of every website plan">
        {planWide.map((line) => <li><Icon name="check" size={18} class="plan-strip__check" /><span>{line}</span></li>)}
      </ul>

      <ol class="plan-ladder">
        {ladder.map((plan, index) => (
          <li class={`plan-card plan-card--${index + 1}`}>
            <article aria-labelledby={`plan-${plan.id}`}>
              <span class={`plan-rungs plan-rungs--${index + 1}`} aria-hidden="true"><i></i><i></i><i></i></span>
              <h3 id={`plan-${plan.id}`}>{plan.name}</h3>
              <p class="plan-card__best"><strong>Best for:</strong> {plan.bestFor}</p>
              <p class="plan-card__when"><strong>Choose it when:</strong> {plan.whenToChoose}</p>
              <p class="plan-adds"><span class="plan-adds__label">{plan.addsOverPrior ? 'What moving up here adds' : 'Where it starts'}</span>{plan.addsOverPrior ?? 'The baseline shape that Business builds on.'}</p>
              <h4 class="plan-card__sub">Includes</h4>
              <ul class="plan-card__list plan-card__list--in">
                {plan.includes.map((item) => <li><Icon name="check" size={16} class="plan-check" /><span>{item}</span></li>)}
              </ul>
              <h4 class="plan-card__sub">Its own limit</h4>
              <ul class="plan-card__list plan-card__list--out">
                {ownLimits(plan).map((item) => <li>{item}</li>)}
              </ul>
            </article>
          </li>
        ))}
      </ol>

      {customPlan && (
        <article class="plan-custom" aria-labelledby="plan-custom">
          <div class="plan-custom__lead">
            <span class="pill pill--onnavy">Off the ladder</span>
            <h3 id="plan-custom">{customPlan.name}</h3>
            <p><strong>Best for:</strong> {customPlan.bestFor}</p>
            <p><strong>Choose it when:</strong> {customPlan.whenToChoose}</p>
            <p class="plan-custom__adds">{customPlan.addsOverPrior}</p>
          </div>
          <div class="plan-custom__body">
            <h4 class="plan-card__sub">Includes</h4>
            <ul class="plan-card__list plan-card__list--in">
              {customPlan.includes.map((item) => <li><Icon name="check" size={16} class="plan-check" /><span>{item}</span></li>)}
            </ul>
            <h4 class="plan-card__sub">Its own limit</h4>
            <ul class="plan-card__list plan-card__list--out">
              {ownLimits(customPlan).map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      )}

      <div class="plan-compare-cta actions">
        <a class="button" href="/discovery/">Describe your project</a>
      </div>
    </div>
  </section>
</BaseLayout>
