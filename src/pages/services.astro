---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import services from '../data/services.json';
---
<BaseLayout
  title="Website & Automation Services in Beaufort, SC"
  description="Website projects and care, business systems and automation, digital ownership and platform administration, and technology consulting from Lowcountry Digital Works."
>
  <section class="page-hero page-hero--coastal-v2c coastal-v2c-route">
    <div class="container readable">
      <p class="eyebrow">{services.page.eyebrow}</p>
      <h1>{services.page.title}</h1>
      <p class="lede">{services.page.lede}</p>
    </div>
  </section>

  <section class="section section--warm" id="start">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Find your starting point</p>
        <h2>Which of these sounds most like what is happening now?</h2>
        <p class="lede">Four service categories—distinct from website package shapes below.</p>
      </div>

      <div class="service-hub-grid service-choice-list service-choice-list--hub">
        {services.families.map((family) => (
          <article class="service-hub-card service-family service-choice">
            <a class="service-hub-card__surface" href={family.primaryHref}>
              <div class="service-hub-card__index service-family__index">
                <span class="service-hub-card__number" aria-hidden="true">{family.number}</span>
                <span class="service-hub-card__icon service-family__icon"><Icon name={family.icon} size={28} /></span>
              </div>
              <p class="card__kicker">{family.kicker}</p>
              <p class="service-choice__prompt">{family.prompt}</p>
              <h2 class="service-hub-card__title">{family.name}</h2>
              <p>{family.description}</p>
              <span class="service-hub-card__cta">{family.primaryLabel} →</span>
            </a>
            <div class="service-hub-card__links">
              {family.secondaryHref && <a href={family.secondaryHref}>{family.secondaryLabel} →</a>}
              <a href="/connect/">Talk it through →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="plans" aria-labelledby="website-plans-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{services.websitePlans.eyebrow}</p>
        <h2 id="website-plans-title">{services.websitePlans.title}</h2>
        <p class="lede">{services.websitePlans.intro}</p>
        <p class="portfolio-detail-note">{services.websitePlans.quoteNote}</p>
      </div>
      <div class="website-plan-grid">
        {services.websitePlans.plans.map((plan) => (
          <article class="website-plan-card coastal-v2c-surface">
            <p class="website-plan-card__slot" aria-label="Future approved price slot">{plan.priceSlotLabel}</p>
            <h3>{plan.name}</h3>
            <p>{plan.summary}</p>
            <p class="website-plan-card__scope"><strong>Typical scope:</strong> {plan.scope}</p>
            <div class="actions">
              <a class="button button--secondary" href="/connect/">Request a written scope quote</a>
              <a class="text-link" href="/services/websites/">Website service details →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">How LDW chooses the solution</p>
        <h2>Use the smallest change that solves the real problem.</h2>
      </div>
      <div class="editorial-list editorial-list--dark">
        {services.startingPoints.map((item) => <article class="editorial-row"><h3>{item.title}</h3><p>{item.description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container final-cta final-cta--single">
      <div>
        <p class="eyebrow">Not sure which path fits?</p>
        <h2>{services.platformNote.title}</h2>
        <p class="lede">{services.platformNote.body}</p>
      </div>
      <div class="actions"><a class="button" href="/connect/">Tell Eddie what is getting in the way</a></div>
    </div>
  </section>
</BaseLayout>
