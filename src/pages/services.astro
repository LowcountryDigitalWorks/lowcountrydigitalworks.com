---
import BaseLayout from '../layouts/BaseLayout.astro';
import services from '../data/services.json';
---
<BaseLayout
  title="Services"
  description="Websites and website care, business systems and automation, digital ownership and platform administration, and technology consulting from Lowcountry Digital Works."
>
  <section class="page-hero page-hero--compact">
    <div class="container readable">
      <p class="eyebrow">{services.page.eyebrow}</p>
      <h1>{services.page.title}</h1>
      <p class="lede">{services.page.lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container service-directory">
      {services.items.map((service, index) => (
        <article class="service-row">
          <div class="service-row__index" aria-hidden="true">0{index + 1}</div>
          <div class="service-row__main">
            <p class="card__kicker">{service.kicker}</p>
            <h2><a href={'/services/' + service.slug + '/'}>{service.name}</a></h2>
            <p class="lede">{service.description}</p>
            <a class="text-link" href={'/services/' + service.slug + '/'}>See scope, examples, and boundaries</a>
          </div>
          <ul class="service-row__examples" aria-label={service.name + ' examples'}>
            {service.examples.slice(0, 3).map((example) => <li>{example}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--navy">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Ways to begin</p>
        <h2>Start from where the business is today.</h2>
      </div>
      <div class="editorial-columns">
        {services.startingPoints.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container split-callout">
      <div><h2>{services.platformNote.title}</h2><p class="lede">{services.platformNote.body}</p></div>
      <div class="actions"><a class="button" href="/connect/">Discuss a need</a></div>
    </div>
  </section>
</BaseLayout>
