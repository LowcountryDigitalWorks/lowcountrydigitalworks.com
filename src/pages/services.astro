---
import BaseLayout from '../layouts/BaseLayout.astro';
import services from '../data/services.json';
---
<BaseLayout title="Services" description="Websites, applications, automation, technical consulting, digital asset ownership, vendor transitions, and maintenance from Lowcountry Digital Works.">
  <section class="page-hero"><div class="container readable"><p class="eyebrow">{services.page.eyebrow}</p><h1>{services.page.title}</h1><p class="lede">{services.page.lede}</p></div></section>

  <section class="section">
    <div class="container grid grid--2">
      {services.items.map((service) => (
        <article class="card service-card">
          <p class="card__kicker">{service.kicker}</p>
          <h2>{service.name}</h2>
          <p>{service.description}</p>
          <h3>Examples</h3>
          <ul class="card__list">{service.examples.map((example) => <li>{example}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--navy">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Ways to begin</p><h2>Start from where the business is today.</h2></div>
      <div class="grid grid--3">
        {services.startingPoints.map((item) => <article class="card card--dark"><h3>{item.title}</h3><p>{item.description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container readable"><h2>{services.platformNote.title}</h2><p>{services.platformNote.body}</p><div class="actions"><a class="button" href="/contact/">Discuss a need</a></div></div>
  </section>
</BaseLayout>
