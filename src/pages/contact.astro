---
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../data/contact.json';
import site from '../data/site.json';
---
<BaseLayout title="Contact" description="Contact Eddie at Lowcountry Digital Works about a website, automation, business system, digital ownership, platform administration, or technology problem.">
  <section class="page-hero page-hero--compact">
    <div class="container readable"><p class="eyebrow">{contact.hero.eyebrow}</p><h1>{contact.hero.title}</h1><p class="lede">{contact.hero.lede}</p></div>
  </section>

  <section class="section section--warm">
    <div class="container principle">
      <div><p class="eyebrow">{contact.helpfulDetails.eyebrow}</p><h2>{contact.helpfulDetails.title}</h2></div>
      <ul class="check-list">{contact.helpfulDetails.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-methods">
        <article class="contact-method">
          <p class="eyebrow">Email</p>
          <h2>{contact.email.title}</h2>
          <a class="button" href={'mailto:' + contact.email.address}>{contact.email.address}</a>
          <div class="meta-note"><strong>{contact.email.noteTitle}</strong><p>{contact.email.noteBody}</p></div>
        </article>
        <article class="contact-method">
          <p class="eyebrow">Phone</p>
          <h2>{contact.phone.title}</h2>
          <div class="actions">
            <a class="button" href={'sms:' + contact.phone.number}>Text {contact.phone.display}</a>
            <a class="button button--secondary" href={'tel:' + contact.phone.number}>Call {contact.phone.display}</a>
          </div>
          <div class="meta-note"><strong>{contact.phone.noteTitle}</strong><p>{contact.phone.noteBody}</p></div>
        </article>
      </div>
      <aside class="contact-side">
        <p class="eyebrow">Quick connect</p>
        <h2>Prefer one compact contact page?</h2>
        <p>Use the stable LDW Connect page for phone, text, email, verified social profiles, and a downloadable contact card.</p>
        <a class="text-link" href="/connect/">Open Connect</a>
        <div class="social-links" aria-label="Verified social profiles">
          {site.business.social.map((social) => <a href={social.url} rel="me noopener noreferrer">{social.name}</a>)}
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container readable"><p class="eyebrow">{contact.whatNext.eyebrow}</p><h2>{contact.whatNext.title}</h2><p class="lede">{contact.whatNext.body}</p></div>
  </section>
</BaseLayout>
