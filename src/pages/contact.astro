---
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../data/contact.json';
---
<BaseLayout title="Contact" description="Contact Eddie at Lowcountry Digital Works about a website, application, automation, transition, maintenance, or technical problem.">
  <section class="page-hero"><div class="container readable"><p class="eyebrow">{contact.hero.eyebrow}</p><h1>{contact.hero.title}</h1><p class="lede">{contact.hero.lede}</p></div></section>

  <section class="section section--warm">
    <div class="container principle">
      <div><p class="eyebrow">{contact.helpfulDetails.eyebrow}</p><h2>{contact.helpfulDetails.title}</h2></div>
      <ul class="check-list">{contact.helpfulDetails.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container readable"><h2>{contact.email.title}</h2><p><a class="button" href={`mailto:${contact.email.address}`}>{contact.email.address}</a></p><div class="meta-note"><strong>{contact.email.noteTitle}</strong><p>{contact.email.noteBody}</p></div></div>
  </section>

  <section class="section section--navy"><div class="container readable"><p class="eyebrow">{contact.whatNext.eyebrow}</p><h2>{contact.whatNext.title}</h2><p class="lede">{contact.whatNext.body}</p></div></section>
</BaseLayout>
