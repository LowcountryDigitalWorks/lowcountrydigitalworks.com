---
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../data/contact.json';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Contact" description="Contact Eddie Gugino at Lowcountry Digital Works about a website, automation, digital ownership, platform administration, or technical problem." canonicalPath="/connect/">
  <section class="page-hero">
    <div class="container readable"><p class="eyebrow">{contact.hero.eyebrow}</p><h1>{contact.hero.title}</h1><p class="lede">{contact.hero.lede}</p></div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-primary">
        <p class="eyebrow">Direct contact</p>
        <h2>{contact.founder.name} · {contact.founder.role}</h2>
        <div class="contact-actions">
          <a class="button icon-link" href={`sms:${contact.phone.number}`}><Icon name="message" size={18} /><span>Text {contact.phone.display}</span></a>
          <a class="button button--secondary icon-link" href={`tel:${contact.phone.number}`}><Icon name="phone" size={18} /><span>Call {contact.phone.display}</span></a>
          <a class="text-link icon-link" href={`mailto:${contact.email.address}`}><Icon name="mail" size={18} /><span>{contact.email.address}</span></a>
        </div>
        <div class="social-list" aria-label="Verified Lowcountry Digital Works social profiles">
          {contact.socials.map((social) => (
            <a class="icon-link" href={social.href} rel="me noopener">
              <Icon name={social.name === 'Facebook' ? 'facebook' : 'x'} size={18} />
              <span>{social.name}</span>
            </a>
          ))}
        </div>
      </div>
      <div>
        <p class="eyebrow">{contact.helpfulDetails.eyebrow}</p>
        <h2>{contact.helpfulDetails.title}</h2>
        <ul class="check-list">{contact.helpfulDetails.items.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container grid grid--2">
      <article class="contact-safety">
        <h2>{contact.email.noteTitle}</h2>
        <p>{contact.email.noteBody}</p>
      </article>
      <article class="contact-safety">
        <h2>{contact.phone.noteTitle}</h2>
        <p>{contact.phone.noteBody}</p>
      </article>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container final-cta">
      <div><p class="eyebrow">{contact.whatNext.eyebrow}</p><h2>{contact.whatNext.title}</h2><p class="lede">{contact.whatNext.body}</p></div>
      <div><p>Need the compact business-card destination instead?</p><a class="button button--secondary" href="/connect/">Open Connect</a></div>
    </div>
  </section>
</BaseLayout>
