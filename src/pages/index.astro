---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../data/home.json';
import services from '../data/services.json';
import work from '../data/work.json';

const featuredServices = services.items.filter((service) => service.featured);
---
<BaseLayout description="Lowcountry Digital Works builds practical websites, applications, automation, and technical systems with maintainability and client ownership in mind.">
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1>{home.hero.title}</h1>
      <p class="lede">{home.hero.lede}</p>
      <div class="actions"><a class="button" href="/services/">Explore services</a><a class="button button--secondary" href="/work/">See selected work</a></div>
      <ul class="trust-strip" aria-label="Lowcountry Digital Works priorities">
        {home.trustPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{home.services.eyebrow}</p>
        <h2>{home.services.title}</h2>
        <p class="lede">{home.services.intro}</p>
      </div>
      <div class="grid grid--3">
        {featuredServices.map((service) => (
          <article class="card card--accent">
            <p class="card__kicker">{service.kicker}</p>
            <h3>{service.name}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
      <div class="actions"><a href="/services/">See all six service areas</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2>Live work and products in active development.</h2>
        <p class="lede">The business is still being established, so project status is shown plainly rather than presenting unfinished products as completed client work.</p>
      </div>
      <div class="grid grid--3">
        {work.projects.map((project) => (
          <article class="card work-card work-card--compact">
            <div class="work-card__meta"><span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span></div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </article>
        ))}
      </div>
      <div class="actions"><a class="button button--secondary" href="/work/">Explore the work</a></div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.technology.eyebrow}</p>
        <h2>{work.technology.title}</h2>
        <p class="lede">{work.technology.lede}</p>
      </div>
      <div class="technology-grid technology-grid--compact">
        {work.technology.items.map((technology) => (
          <article class="technology-card">
            <img src={technology.icon} alt="" width="40" height="40" loading="lazy" />
            <div><h3>{technology.name}</h3><p>{technology.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{home.commonNeeds.eyebrow}</p>
        <h2>{home.commonNeeds.title}</h2>
      </div>
      <div class="grid grid--2">
        {home.commonNeeds.items.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container principle">
      <div><p class="eyebrow">{home.ownership.eyebrow}</p><h2>{home.ownership.title}</h2><p class="lede">{home.ownership.lede}</p></div>
      <ul class="principle__list">{home.ownership.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">{home.process.eyebrow}</p><h2>{home.process.title}</h2></div>
      <div class="flow">{home.process.steps.map((step) => <article class="flow__step"><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container principle">
      <div><p class="eyebrow">{home.expectations.eyebrow}</p><h2>{home.expectations.title}</h2></div>
      <ul class="check-list">{home.expectations.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container split-callout">
      <div><p class="eyebrow">{home.local.eyebrow}</p><h2>{home.local.title}</h2><p class="lede">{home.local.lede}</p></div>
      <div class="actions"><a class="button button--secondary" href="/about/">About Lowcountry Digital Works</a></div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container readable"><p class="eyebrow">{home.contact.eyebrow}</p><h2>{home.contact.title}</h2><p class="lede">{home.contact.lede}</p><div class="actions"><a class="button" href="mailto:eddie@lowcountrydigitalworks.com">eddie@lowcountrydigitalworks.com</a></div></div>
  </section>
</BaseLayout>
