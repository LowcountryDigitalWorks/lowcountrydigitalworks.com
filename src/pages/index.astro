---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../data/home.json';
import work from '../data/work.json';

const featuredProjects = [work.projects[0], work.projects[3]];
---
<BaseLayout
  description="Owner-operated websites, automation, business systems, digital ownership, and technology consulting from Lowcountry Digital Works."
>
  <section class="section hero hero--editorial">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>{home.hero.title}</h1>
        <p class="lede">{home.hero.lede}</p>
        <div class="actions">
          <a class="button" href="/connect/">Start a conversation</a>
          <a class="button button--secondary" href="/work/">See selected work</a>
        </div>
        <ul class="trust-strip" aria-label="Lowcountry Digital Works priorities">
          {home.trustPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <aside class="hero-proof" aria-label="Lowcountry Digital Works delivery principles">
        <p class="hero-proof__label">Owner-operated technology partner</p>
        <div class="hero-proof__metric"><strong>Own the account.</strong><span>LDW uses named, scoped access where practical.</span></div>
        <div class="hero-proof__metric"><strong>Use what already works.</strong><span>Configure and integrate before custom build.</span></div>
        <div class="hero-proof__metric"><strong>Leave a clean exit.</strong><span>Document handoff, recovery, rollback, and ongoing care.</span></div>
      </aside>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{home.services.eyebrow}</p>
        <h2>{home.services.title}</h2>
        <p class="lede">{home.services.intro}</p>
      </div>
      <div class="service-pathway-list">
        {home.services.pathways.map((pathway, index) => (
          <article class="service-pathway">
            <div class="service-pathway__number" aria-hidden="true">0{index + 1}</div>
            <div>
              <h3><a href={pathway.href}>{pathway.title}</a></h3>
              <p>{pathway.description}</p>
              {pathway.secondaryHref && <a class="text-link" href={pathway.secondaryHref}>{pathway.secondaryLabel} details</a>}
            </div>
          </article>
        ))}
      </div>
      <div class="actions"><a class="button button--secondary" href="/services/">Explore all services</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2>Evidence over adjectives.</h2>
        <p class="lede">See what is live, what is still being developed, and what each project demonstrates without turning internal work into invented customer results.</p>
      </div>
      <div class="project-teasers">
        {featuredProjects.map((project) => (
          <article class="project-teaser">
            <div class="project-teaser__visual">
              {project.image ? (
                <img src={project.image} alt={project.imageAlt} width="1440" height="1000" loading="lazy" />
              ) : (
                <div class="evidence-visual" aria-label={project.name + ' evidence summary'}>
                  <span>{project.status}</span>
                  <strong>{project.type}</strong>
                  <small>Human-reviewed evidence and clear scope boundaries.</small>
                </div>
              )}
            </div>
            <div class="project-teaser__copy">
              <div class="work-card__meta">
                <span class={'status-pill ' + (project.status === 'Live' ? 'status-pill--live' : '')}>{project.status}</span>
                <span>{project.type}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <a class="text-link" href={'/work/' + project.slug + '/'}>View project evidence</a>
            </div>
          </article>
        ))}
      </div>
      <div class="actions"><a class="button button--secondary" href="/work/">Explore all selected work</a></div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container principle">
      <div>
        <p class="eyebrow">{home.ownership.eyebrow}</p>
        <h2>{home.ownership.title}</h2>
        <p class="lede">{home.ownership.lede}</p>
      </div>
      <ul class="principle__list">{home.ownership.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container founder-grid">
      <figure class="founder-placeholder">
        <div aria-hidden="true">Founder photo</div>
        <figcaption>Owner-selected photo required before production.</figcaption>
      </figure>
      <div>
        <p class="eyebrow">{home.founder.eyebrow}</p>
        <h2>{home.founder.title}</h2>
        <p class="lede">{home.founder.body}</p>
        <p class="preview-note">{home.founder.note}</p>
        <div class="actions"><a class="button button--secondary" href="/about/">About Eddie & LDW</a></div>
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{home.process.eyebrow}</p>
        <h2>{home.process.title}</h2>
      </div>
      <div class="flow">{home.process.steps.map((step) => <article class="flow__step"><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container split-callout">
      <div>
        <p class="eyebrow">{home.contact.eyebrow}</p>
        <h2>{home.contact.title}</h2>
        <p class="lede">{home.contact.lede}</p>
      </div>
      <div class="actions"><a class="button" href="/connect/">Connect with Eddie</a></div>
    </div>
  </section>
</BaseLayout>
