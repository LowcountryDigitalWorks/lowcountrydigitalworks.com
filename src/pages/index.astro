---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import home from '../data/home.json';
import work from '../data/work.json';
---
<BaseLayout description="Owner-operated websites, business systems, automation, digital ownership, and practical technology consulting from Beaufort, South Carolina.">
  <div itemscope itemtype="https://schema.org/WebSite" itemid="https://lowcountrydigitalworks.com/#website">
    <link itemprop="url" href="https://lowcountrydigitalworks.com/" />
    <meta itemprop="name" content="Lowcountry Digital Works" />
    <meta itemprop="alternateName" content="LDW" />
  </div>

  <section class="section hero hero--coastal">
    <div class="container hero-coastal-grid">
      <div class="hero-copy hero-copy--coastal">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>{home.hero.title}</h1>
        <p class="lede">{home.hero.lede}</p>
        <div class="actions hero-actions">
          <a class="button" href="/discovery/">Start with discovery</a>
          <a class="button button--secondary" href="#start">See services</a>
        </div>
        <a class="hero-work-link" href="#client-work">See the work</a>
      </div>

      <aside class="hero-owner-card hero-owner-card--compact" aria-label="Owner-operated by Eddie Gugino" itemscope itemtype="https://schema.org/Person">
        <div class="hero-owner-card__portrait-shell">
          <img
            class="hero-owner-card__portrait"
            data-founder-portrait
            itemprop="image"
            src="/founder/eddie-gugino-founder.webp"
            alt="Eddie Gugino, founder of Lowcountry Digital Works"
            width="480"
            height="600"
            decoding="async"
          />
        </div>
        <div class="hero-owner-card__content">
          <p class="eyebrow">Owner-operated</p>
          <h2>Work directly with Eddie.</h2>
          <p class="hero-owner-card__name"><strong itemprop="name">{home.founder.name}</strong> · <span itemprop="jobTitle">{home.founder.role}</span></p>
          <p>{home.founder.lede}</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="service-area section" aria-labelledby="service-area-title">
    <div class="container service-area__inner">
      <div class="section-heading">
        <p class="eyebrow">Local service area</p>
        <h2 id="service-area-title">Serving the Lowcountry</h2>
        <p class="lede">Based in Beaufort, South Carolina, LDW works with organizations across these Lowcountry communities.</p>
      </div>
      <ul class="service-area__list" aria-label="Lowcountry service areas">
        <li>Beaufort</li><li>Port Royal</li><li>Habersham</li><li>Lady’s Island</li><li>Burton</li>
        <li>St. Helena Island</li><li>Fripp Island</li><li>Bluffton</li><li>Okatie</li><li>Ridgeland</li><li>Hardeeville</li>
      </ul>
      <p class="service-area__note">The right project may fit elsewhere, too. Hilton Head work is considered case by case.</p>
    </div>
  </section>

  <section class="section section--warm section--tidal" id="start">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{home.services.eyebrow}</p>
        <h2>{home.services.title}</h2>
        <p class="lede">{home.services.intro}</p>
      </div>
      <div class="pathway-list solution-grid">
        {home.startingPoints.map((point) => (
          <article class="pathway solution-card">
            <p class="pathway__number">{point.number}</p>
            <div>
              <p class="card__kicker">Starting point</p>
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </div>
            <div class="pathway__actions">
              <a href={point.serviceHref}>{point.service} →</a>
              {point.secondaryHref && <a href={point.secondaryHref}>{point.secondaryService} →</a>}
              <a href="/connect/">Talk it through →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="client-work" data-home-client-work>
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.clientWork.eyebrow}</p>
        <h2>{work.clientWork.title}</h2>
        <p class="lede">{work.clientWork.lede}</p>
      </div>
      <div class="portfolio-grid portfolio-grid--work">
        {work.clientWork.items.map((client) => (
          <article class="portfolio-card portfolio-card--work portfolio-card--proof" data-client-proof={client.id}>
            <div class="portfolio-card__body">
              <div class="work-row__meta">
                <span class="status-pill status-pill--live">Live client site</span>
                <span>{client.type}</span>
              </div>
              <h3>{client.name}</h3>
              <p>{client.context}</p>
              <p><strong>Live proof:</strong> {client.proof}</p>
              <a class="text-link" href={client.href} rel="noopener noreferrer">Visit live site: {client.name} →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="portfolio-detail-note"><a class="text-link" href="/work/">See all work →</a></p>
    </div>
  </section>

  <section class="section section--warm" data-home-internal-proof>
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.internalProof.eyebrow}</p>
        <h2>{work.internalProof.title}</h2>
        <p class="lede">{work.internalProof.lede}</p>
      </div>
      <div class="portfolio-grid portfolio-grid--home">
        {work.projects.map((project) => (
          <article class="portfolio-card">
            {project.thumbnail && (
              <a class="portfolio-card__visual" href={`/work/${project.slug}/`} aria-label={`View ${project.name} project details`}>
                <img
                  src={project.thumbnail.src}
                  alt=""
                  width={project.thumbnail.width}
                  height={project.thumbnail.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div class="portfolio-card__body">
              <div class="work-row__meta">
                <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
                <span>{project.type}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.homeSummary ?? project.purpose}</p>
              <a class="text-link" href={`/work/${project.slug}/`} aria-label={`View ${project.name} project details`}>Explore the work →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container principle">
      <div>
        <p class="eyebrow">{home.ownership.eyebrow}</p>
        <h2>{home.ownership.title}</h2>
        <p class="lede">{home.ownership.lede}</p>
      </div>
      <ul class="principle__list">{home.ownership.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">{home.process.eyebrow}</p><h2>{home.process.title}</h2></div>
      <div class="flow">{home.process.steps.map((step) => <article class="flow__step"><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FaqList items={home.faq.items} eyebrow={home.faq.eyebrow} title={home.faq.title} />
    </div>
  </section>

  <section class="section section--navy section--invitation">
    <div class="container final-cta">
      <div>
        <p class="eyebrow">{home.local.eyebrow}</p>
        <h2>{home.local.title}</h2>
        <p class="lede">{home.local.lede}</p>
      </div>
      <div>
        <p class="eyebrow">{home.contact.eyebrow}</p>
        <h2>{home.contact.title}</h2>
        <p>{home.contact.lede}</p>
        <div class="actions"><a class="button button--secondary" href="/connect/">Connect with Eddie</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
