---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import home from '../data/home.json';
import work from '../data/work.json';
import contact from '../data/contact.json';
---
<BaseLayout description="Owner-operated websites, business systems, automation, digital ownership, and practical technology consulting from Beaufort, South Carolina.">
  <div itemscope itemtype="https://schema.org/WebSite" itemid="https://lowcountrydigitalworks.com/#website">
    <link itemprop="url" href="https://lowcountrydigitalworks.com/" />
    <meta itemprop="name" content="Lowcountry Digital Works" />
    <meta itemprop="alternateName" content="LDW" />
  </div>

  <section class="section hero hero--rev3">
    <div class="container hero-rev3">
      <div class="hero-rev3__copy">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>{home.hero.title}</h1>
        <p class="lede">{home.hero.lede}</p>
        <div class="actions hero-actions">
          <a class="button" href="/discovery/">Talk through your project</a>
          <a class="text-link hero-secondary-link" href={`sms:${contact.phone.number}`}>or text Eddie, {contact.phone.display}</a>
        </div>
        <p class="hero-support">{home.contact.secondaryNote}</p>
        <ul class="trust-strip trust-strip--plain" aria-label="Lowcountry Digital Works priorities">
          {home.trustPoints.map((point) => <li>{point}</li>)}
        </ul>
        <p class="hero-service-area">Beaufort-based &middot; serving the Lowcountry.</p>
        <a class="hero-work-link" href="#client-work">See the work</a>
      </div>

      <aside class="hero-founder-row" aria-label="Owner-operated by Eddie Gugino" itemscope itemtype="https://schema.org/Person">
        <img
          class="hero-founder-row__portrait"
          data-founder-portrait
          itemprop="image"
          src="/founder/eddie-gugino-founder.webp"
          alt="Eddie Gugino, founder of Lowcountry Digital Works"
          width="480"
          height="600"
          decoding="async"
        />
        <div class="hero-founder-row__content">
          <p class="eyebrow">{home.founder.eyebrow}</p>
          <p class="hero-founder-row__name"><strong itemprop="name">{home.founder.name}</strong> · <span itemprop="jobTitle">{home.founder.role}</span></p>
          <p>{home.founder.lede}</p>
        </div>
      </aside>
    </div>
  </section>

  <div class="wave-divider" aria-hidden="true"></div>

  <section class="section section--warm" id="start">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{home.services.eyebrow}</p>
        <h2>{home.services.title}</h2>
        <p class="lede">{home.services.intro}</p>
      </div>
      <div class="problem-choice-list">
        {home.startingPoints.map((point) => (
          <a class="problem-choice" href={point.serviceHref}>
            <span class="problem-choice__number" aria-hidden="true">{point.number}</span>
            <span class="problem-choice__body">
              <span class="problem-choice__title">{point.title}</span>
              <span class="problem-choice__desc">{point.description}</span>
            </span>
            <span class="problem-choice__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="wave-divider" aria-hidden="true"></div>

  <section class="section" id="client-work" data-home-client-work>
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.clientWork.eyebrow}</p>
        <h2>{work.clientWork.title}</h2>
        <p class="lede">{work.clientWork.lede}</p>
      </div>
      <div class="portfolio-grid portfolio-grid--work portfolio-grid--client-proof">
        {work.clientWork.items.map((client) => (
          <article class="portfolio-card portfolio-card--work portfolio-card--proof" data-client-proof={client.id}>
            {client.thumbnail && (
              <a class="portfolio-card__visual" href={client.href} rel="noopener noreferrer" aria-label={`Visit live site: ${client.name}`}>
                <img
                  src={client.thumbnail.src}
                  srcset={client.thumbnail.srcMobile ? `${client.thumbnail.srcMobile} 390w, ${client.thumbnail.src} 1280w` : undefined}
                  sizes="(max-width: 680px) 100vw, 560px"
                  alt={client.thumbnail.alt}
                  width={client.thumbnail.width}
                  height={client.thumbnail.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div class="portfolio-card__body">
              <div class="work-row__meta">
                <span class="status-pill status-pill--live">Live client site</span>
                <span>{client.type}</span>
              </div>
              <h3>{client.name}</h3>
              <p>{client.context}</p>
              <p><strong>Live proof:</strong> {client.proof}</p>
              <a class="text-link" href={client.href} rel="noopener noreferrer">Visit live site: {client.name} →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="portfolio-detail-note"><a class="text-link" href="/work/">See all work →</a></p>
    </div>
  </section>

  <div class="wave-divider" aria-hidden="true"></div>

  <section class="section section--warm section--internal-compact" data-home-internal-proof>
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{work.internalProof.eyebrow}</p>
        <h2>{work.internalProof.title}</h2>
        <p class="lede">{work.internalProof.lede}</p>
      </div>
      <div class="portfolio-grid portfolio-grid--home">
        {work.projects.map((project) => (
          <article class="portfolio-card">
            {project.thumbnail && (
              <a class="portfolio-card__visual" href={`/work/${project.slug}/`} aria-label={`View ${project.name} project details`}>
                <img
                  src={project.thumbnail.src}
                  alt=""
                  width={project.thumbnail.width}
                  height={project.thumbnail.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div class="portfolio-card__body">
              <div class="work-row__meta">
                <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
                <span>{project.type}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.homeSummary ?? project.purpose}</p>
              <a class="text-link" href={`/work/${project.slug}/`} aria-label={`Explore the work — ${project.name}`}>Explore the work →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy section--cta-band">
    <div class="container final-cta final-cta--single">
      <div>
        <p class="eyebrow">{home.contact.eyebrow}</p>
        <h2>{home.contact.title}</h2>
        <p class="lede">{home.contact.lede}</p>
        <p class="cta-support">{home.contact.secondaryNote}</p>
      </div>
      <div class="actions cta-band-actions">
        <a class="button button--oyster" href={home.contact.primaryHref}>{home.contact.primaryCta}</a>
        <a class="text-link text-link--light" href={`sms:${contact.phone.number}`}>or text Eddie, {contact.phone.display}</a>
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <FaqList items={home.faq.items} eyebrow={home.faq.eyebrow} title={home.faq.title} />
    </div>
  </section>
  <section class="section section--warm service-area" aria-labelledby="service-area-title">
    <div class="container service-area__inner">
      <div class="section-heading">
        <p class="eyebrow">{home.serviceAreas.eyebrow}</p>
        <h2 id="service-area-title">{home.serviceAreas.title}</h2>
        <p class="lede">{home.serviceAreas.lede}</p>
      </div>
      <div>
        <ul class="service-area__list" aria-label="Lowcountry service areas">
          {home.serviceAreas.items.map((area) => <li>{area}</li>)}
        </ul>
        <p class="service-area__note">{home.serviceAreas.note}</p>
      </div>
    </div>
  </section>
</BaseLayout>
