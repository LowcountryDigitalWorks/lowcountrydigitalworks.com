---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../data/home.json';
import services from '../data/services.json';
import work from '../data/work.json';
---
<BaseLayout description="Owner-operated websites, business systems, automation, digital ownership, and technology consulting from Lowcountry Digital Works.">
  <section class="section hero hero--editorial">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>{home.hero.title}</h1>
        <p class="lede">{home.hero.lede}</p>
        <div class="actions">
          <a class="button" href="/connect/">Start a conversation</a>
          <a class="button button--secondary" href="/work/">See selected work</a>
        </div>
        <ul class="trust-strip" aria-label="Lowcountry Digital Works priorities">
          {home.trustPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <aside class="hero-proof" aria-label="Lowcountry Digital Works delivery principles">
        <p class="eyebrow">{home.heroProof.eyebrow}</p>
        <h2>{home.heroProof.title}</h2>
        <ul class="proof-list">{home.heroProof.items.map((item) => <li>{item}</li>)}</ul>
        <a class="text-link" href="/approach/">See the delivery approach →</a>
      </aside>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{home.services.eyebrow}</p>
        <h2>{home.services.title}</h2>
        <p class="lede">{home.services.intro}</p>
      </div>
      <div class="pathway-list">
        {services.families.map((family) => (
          <article class="pathway">
            <p class="pathway__number">{family.number}</p>
            <div>
              <p class="card__kicker">{family.kicker}</p>
              <h3>{family.name}</h3>
              <p>{family.description}</p>
            </div>
            <div class="pathway__actions">
              <a href={family.primaryHref}>{family.primaryLabel} →</a>
              {family.secondaryHref && <a href={family.secondaryHref}>{family.secondaryLabel} →</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2>Real systems, with status and boundaries shown plainly.</h2>
        <p class="lede">Work is presented as evidence of approach, not as invented customer success stories.</p>
      </div>
      <div class="work-list">
        {work.projects.map((project) => (
          <article class="work-row">
            <div class="work-row__meta">
              <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
              <span>{project.type}</span>
            </div>
            <div>
              <h3>{project.name}</h3>
              <p>{project.purpose}</p>
            </div>
            <a class="work-row__link" href={`/work/${project.slug}/`} aria-label={`View ${project.name} project details`}>View evidence →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container founder-block" itemscope itemtype="https://schema.org/Person">
      <div class="founder-photo-placeholder" data-owner-asset-pending="founder-photo" role="img" aria-label="Founder photo pending owner selection">
        <span>Founder photo</span>
        <small>Owner selection pending before production</small>
      </div>
      <div>
        <p class="eyebrow">{home.founder.eyebrow}</p>
        <h2>{home.founder.title}</h2>
        <p class="founder-name"><strong itemprop="name">{home.founder.name}</strong> · <span itemprop="jobTitle">{home.founder.role}</span></p>
        <p class="lede">{home.founder.lede}</p>
        <p class="owner-review-note">{home.founder.note}</p>
        <a class="button button--secondary" href="/about/">About Eddie & LDW</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container principle">
      <div>
        <p class="eyebrow">{home.ownership.eyebrow}</p>
        <h2>{home.ownership.title}</h2>
        <p class="lede">{home.ownership.lede}</p>
      </div>
      <ul class="principle__list">{home.ownership.items.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">{home.process.eyebrow}</p><h2>{home.process.title}</h2></div>
      <div class="flow">{home.process.steps.map((step) => <article class="flow__step"><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container final-cta">
      <div>
        <p class="eyebrow">{home.local.eyebrow}</p>
        <h2>{home.local.title}</h2>
        <p class="lede">{home.local.lede}</p>
      </div>
      <div>
        <p class="eyebrow">{home.contact.eyebrow}</p>
        <h2>{home.contact.title}</h2>
        <p>{home.contact.lede}</p>
        <div class="actions"><a class="button" href="/connect/">Connect with Eddie</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
