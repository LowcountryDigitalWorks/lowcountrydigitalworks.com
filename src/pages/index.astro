---
import InternalToolThumb from '../components/InternalToolThumb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import ProofCollage from '../components/ProofCollage.astro';
import ProblemChoiceList from '../components/ProblemChoiceList.astro';
import ClientProofGrid from '../components/ClientProofGrid.astro';
import FounderCtaBand from '../components/FounderCtaBand.astro';
import RequestFlowSteps from '../components/RequestFlowSteps.astro';
import ServiceAreaTowns from '../components/ServiceAreaTowns.astro';
import home from '../data/home.json';
import work from '../data/work.json';
import contact from '../data/contact.json';
---
<BaseLayout
  title="Websites & Business Systems in Beaufort, SC"
  description="Owner-operated websites, website care, business automation, and digital ownership for Beaufort and Lowcountry businesses. Work directly with Eddie on your next step."
>
  <div itemscope itemtype="https://schema.org/WebSite" itemid="https://lowcountrydigitalworks.com/#website">
    <link itemprop="url" href="https://lowcountrydigitalworks.com/" />
    <meta itemprop="name" content="Lowcountry Digital Works" />
    <meta itemprop="alternateName" content="LDW" />
  </div>

  <section class="hero hero--coastal" aria-labelledby="hero-heading">
    <div class="container hero-grid">
      <div class="hero-navy-plate">
        <div class="hero-copy">
          <p class="eyebrow">{home.hero.eyebrow}</p>
          <h1 id="hero-heading">{home.hero.title}</h1>
          <p class="lede">{home.hero.lede}</p>
        </div>
        <div class="cta-plate">
          <div class="actions hero-actions">
            <a class="button" href="/discovery/">Talk through your project</a>
            <a class="text-link hero-secondary-link" href={`sms:${contact.phone.number}`}>or text Eddie, {contact.phone.display}</a>
          </div>
          <p class="hero-support">{home.contact.secondaryNote}</p>
          <a class="hero-work-link see-the-work-link" href="#client-work">See the work</a>
        </div>
      </div>

      <aside class="hero-owner-card hero-owner-card--compact" aria-label="Owner-operated by Eddie Gugino" itemscope itemtype="https://schema.org/Person">
        <div class="hero-owner-card__portrait-shell">
          <img
            class="hero-owner-card__portrait"
            data-founder-portrait
            itemprop="image"
            src="/founder/eddie-gugino-founder.webp"
            alt="Eddie Gugino, founder of Lowcountry Digital Works"
            width="480"
            height="600"
            decoding="async"
          />
        </div>
        <div class="hero-owner-card__content">
          <p class="eyebrow">{home.founder.eyebrow}</p>
          <p class="hero-owner-card__name"><strong itemprop="name">{home.founder.name}</strong> · <span itemprop="jobTitle">{home.founder.role}</span></p>
          <p>{home.founder.lede}</p>
        </div>
      </aside>

      <div class="hero-stage">
        <p class="device-cluster__caption">Example: live client site</p>
        <ProofCollage />
        <div class="hero-phone-mobile">
          <a class="device device--phone-solo" href="#client-work" aria-label="Example: live client site, East Coast Foam">
            <span class="device__body"><span class="device__screen">
              <picture>
                <source media="(min-width: 900px)" srcset="/r5/assets/art/blank.png" width="1" height="1" />
                <source type="image/avif" srcset="/r5/assets/clients/east-coast-foam-lockup.avif" />
                <source type="image/webp" srcset="/r5/assets/clients/east-coast-foam-lockup.webp" />
                <img src="/r5/assets/clients/east-coast-foam-lockup.jpg" alt="East Coast Foam website, showing the site header and headline. Example: live client site." width="390" height="330" />
              </picture>
            </span></span>
          </a>
          <p class="example-label">Example: live client site · East Coast Foam</p>
        </div>
      </div>
    </div>
  </section>

  <div class="wave-divider" aria-hidden="true"></div>

  <section class="router-section section section--warm" id="start" aria-labelledby="router-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Start from the problem</p>
        <h2 id="router-heading">{home.services.title}</h2>
        <p class="lede">{home.services.intro}</p>
      </div>
      <ProblemChoiceList items={home.startingPoints} />
      <p class="portfolio-detail-note" data-home-website-care>
        Already have a website that needs regular attention?
        <a class="text-link" href="/services/website-care/">Explore Website Care →</a>
      </p>
    </div>
  </section>

  <div class="wave-divider" aria-hidden="true"></div>

  <ClientProofGrid
    home
    eyebrow={work.clientWork.eyebrow}
    title={work.clientWork.title}
    lede={work.clientWork.lede}
    items={work.clientWork.items}
  />

  <div class="wave-divider" aria-hidden="true"></div>

  <section class="section section--plain section--internal-compact" data-home-internal-proof aria-labelledby="tools-heading">
    <div class="container tools-split">
      <div class="tools-split__story">
        <p class="eyebrow">{work.internalProof.eyebrow}</p>
        <h2 id="tools-heading">{work.internalProof.title}</h2>
        <p class="lede">{work.internalProof.lede}</p>
      </div>
      <div class="portfolio-grid portfolio-grid--home">
        {work.projects.filter((project) => project.featured !== false).map((project) => (
          <article class="portfolio-card">
            {project.thumbnail && (
              <a class="portfolio-card__visual" href={`/work/${project.slug}/`} aria-label={`View ${project.name} project details`}>
                <InternalToolThumb thumbnail={project.thumbnail} lazy />
              </a>
            )}
            <div class="portfolio-card__body">
              <div class="work-row__meta">
                <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
                <span>{project.type}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.homeSummary ?? project.purpose}</p>
              <a class="text-link" href={`/work/${project.slug}/`} aria-label={`Explore the work — ${project.name}`}>Explore the work →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--warm request-flow" aria-labelledby="request-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">How a request moves</p>
        <h2 id="request-heading">You write, Eddie reviews, then a reply.</h2>
        <p class="lede">Start with text, call, or email—or use the guided project form when you want more structure. A person reads what you sent and replies with a sensible next step.</p>
      </div>
      <RequestFlowSteps />
      <picture class="request-flow__diagram">
        <source media="(max-width: 899px)" srcset="/r5/assets/diagrams/how-a-request-moves-phone.svg" />
        <img
          class="diagram"
          src="/r5/assets/diagrams/how-a-request-moves.svg"
          alt=""
          width="960"
          height="240"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </picture>
    </div>
  </section>

  <FounderCtaBand
    title={home.founderCta.title}
    lede={home.contact.lede}
    note={home.founderCta.secondaryNote}
    href="/discovery/"
    cta={home.founderCta.primaryCta}
    phoneHref={`sms:${contact.phone.number}`}
    phoneDisplay={contact.phone.display}
  />

  <ServiceAreaTowns serviceAreas={home.serviceAreas} />

  <section class="section section--warm">
    <div class="container">
      <FaqList items={home.faq.items} eyebrow={home.faq.eyebrow} title={home.faq.title} />
    </div>
  </section>
</BaseLayout>
