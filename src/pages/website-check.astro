---
import BaseLayout from '../layouts/BaseLayout.astro';
import sample from '../data/audit-sample.json';
---

<BaseLayout
  title="Website Check Sample"
  description="A sample of how Lowcountry Digital Works could explain website review evidence. This page uses synthetic examples and does not scan websites."
  noindex
>
  <div class="audit-demo">
    <section class="audit-demo__hero" aria-labelledby="audit-title">
      <div class="container audit-demo__hero-inner">
        <p class="audit-demo__label">{sample.label}</p>
        <h1 id="audit-title">See how a website review could work.</h1>
        <p class="audit-demo__lede">A clear explanation of a sample finding, how someone could verify it, and what a possible next step might be.</p>
        <p class="audit-demo__notice">
          <strong>This prototype does not scan a website.</strong> It displays precomputed synthetic examples only. No domain is requested, and no audit provider is contacted.
        </p>
      </div>
    </section>

    <section class="container audit-demo__section" aria-labelledby="sample-state-title">
      <div class="audit-demo__section-heading">
        <div>
          <p class="eyebrow">Review state</p>
          <h2 id="sample-state-title">Demo ready — no scan was run.</h2>
        </div>
        <p class="audit-demo__state">Precomputed sample</p>
      </div>

      <p class="audit-demo__state-copy">The page is showing a saved example fixture. It has no live progress, current website result, or automatic recheck.</p>

      <dl class="audit-demo__summary" aria-label="Sample coverage summary">
        <div><dt>Example cards</dt><dd>{sample.findings.length}</dd></div>
        <div><dt>Live checks</dt><dd>0</dd></div>
        <div><dt>Website pages checked</dt><dd>0</dd></div>
        <div><dt>Sample date</dt><dd>{sample.fixtureDate}</dd></div>
      </dl>
    </section>

    <section class="audit-demo__findings" aria-labelledby="findings-title">
      <div class="container">
        <div class="audit-demo__section-heading audit-demo__findings-heading">
          <div>
            <p class="eyebrow">Example evidence</p>
            <h2 id="findings-title">Two ways a finding could be explained</h2>
          </div>
          <p class="audit-demo__coverage">Coverage: illustrative records only. No real domain or page was checked.</p>
        </div>

        <div class="audit-demo__cards">
          {sample.findings.map((finding, index) => (
            <article class="audit-demo__card" aria-labelledby={`${finding.id}-title`}>
              <div class="audit-demo__card-top">
                <p class="audit-demo__category">{finding.category}</p>
                <p class="audit-demo__tag">Example {index + 1} of {sample.findings.length}</p>
              </div>
              <h3 id={`${finding.id}-title`}>{finding.title}</h3>
              <p class="audit-demo__summary-text">{finding.summary}</p>

              <details class="audit-demo__details">
                <summary>View sample evidence and next steps</summary>
                <div class="audit-demo__details-body">
                  <dl class="audit-demo__metadata">
                    <div><dt>Source</dt><dd>{sample.source}</dd></div>
                    <div><dt>Fixture date</dt><dd>{sample.fixtureDate}</dd></div>
                    <div><dt>Freshness</dt><dd>{sample.freshness}</dd></div>
                    <div><dt>Coverage</dt><dd>{sample.coverage}; one hypothetical example.</dd></div>
                  </dl>

                  <h4>What it could mean</h4>
                  <p>{finding.meaning}</p>

                  <h4>Possible verification path</h4>
                  <p>{finding.verification}</p>

                  <h4>Possible action owner</h4>
                  <p>{finding.owner}</p>

                  <div class="audit-demo__comparison" aria-label="Illustrative before and after, not a verified change">
                    <div><h4>Before</h4><p>{finding.before}</p></div>
                    <div><h4>Illustrative after</h4><p>{finding.after}</p></div>
                  </div>
                  <p class="audit-demo__recheck"><strong>Recheck:</strong> {finding.recheck}</p>
                </div>
              </details>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container audit-demo__next" aria-labelledby="next-title">
      <div>
        <p class="eyebrow">A useful next step</p>
        <h2 id="next-title">Want to talk through a real website?</h2>
        <p>This sample is not a result for your business. If you want to discuss a real review, share what you are trying to understand and LDW can help define a suitable next step.</p>
      </div>
      <a class="button" href="/discovery/">Start a project conversation <span aria-hidden="true">→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .audit-demo { color: var(--text); }
  .audit-demo__hero { padding: clamp(3.25rem, 8vw, 6rem) 0 3rem; background: var(--surface-warm); }
  .audit-demo__hero-inner { max-width: 820px; }
  .audit-demo__label { display: inline-block; margin: 0 0 1rem; padding: .35rem .7rem; border: 2px solid var(--interactive); border-radius: var(--radius-sm); font-size: .82rem; font-weight: 800; letter-spacing: .08em; }
  .audit-demo h1 { max-width: 16ch; margin: 0; font-size: clamp(2.2rem, 6vw, 4.3rem); line-height: 1.08; }
  .audit-demo__lede { max-width: 62ch; margin: 1.2rem 0; font-size: clamp(1.1rem, 2.3vw, 1.35rem); }
  .audit-demo__notice { max-width: 70ch; margin: 1.5rem 0 0; padding: 1rem 1.15rem; border-left: 4px solid var(--interactive); background: var(--surface); }
  .audit-demo__section { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .audit-demo__section-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; }
  .audit-demo__section-heading h2, .audit-demo__next h2 { margin: 0; font-size: clamp(1.55rem, 3vw, 2.2rem); line-height: 1.2; }
  .audit-demo__state { margin: 0; padding: .45rem .75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-weight: 750; }
  .audit-demo__state-copy { max-width: 70ch; color: var(--muted); }
  .audit-demo__summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin: 1.5rem 0 0; }
  .audit-demo__summary > div { min-width: 0; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  .audit-demo__summary dt { color: var(--muted); font-size: .88rem; }
  .audit-demo__summary dd { margin: .25rem 0 0; font-size: 1.2rem; font-weight: 800; overflow-wrap: anywhere; }
  .audit-demo__findings { padding-block: clamp(2.5rem, 6vw, 4rem); background: var(--surface); }
  .audit-demo__findings-heading { margin-bottom: 1.5rem; }
  .audit-demo__coverage { max-width: 42ch; margin: 0; color: var(--muted); }
  .audit-demo__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .audit-demo__card { min-width: 0; padding: clamp(1.15rem, 3vw, 1.7rem); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg); }
  .audit-demo__card-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; }
  .audit-demo__category, .audit-demo__tag { margin: 0; font-size: .84rem; font-weight: 750; }
  .audit-demo__tag { padding: .2rem .5rem; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .audit-demo__card h3 { margin: 1rem 0 .5rem; font-size: 1.35rem; line-height: 1.25; }
  .audit-demo__summary-text { margin: 0 0 1.2rem; }
  .audit-demo__details { border-top: 1px solid var(--border); }
  .audit-demo__details summary { padding: .9rem 0 .15rem; color: var(--interactive); font-weight: 750; text-decoration: underline; text-underline-offset: .18em; cursor: pointer; }
  .audit-demo__details-body { padding-top: .75rem; }
  .audit-demo__details-body h4 { margin: 1.25rem 0 .25rem; font-size: 1rem; }
  .audit-demo__details-body p { margin: .25rem 0; }
  .audit-demo__metadata { display: grid; gap: .6rem; margin: 0; }
  .audit-demo__metadata > div { display: grid; grid-template-columns: minmax(6rem, .35fr) minmax(0, 1fr); gap: .6rem; }
  .audit-demo__metadata dt { font-weight: 750; }
  .audit-demo__metadata dd { margin: 0; overflow-wrap: anywhere; }
  .audit-demo__comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: 1rem; }
  .audit-demo__comparison > div { min-width: 0; padding: .8rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  .audit-demo__comparison h4 { margin-top: 0; }
  .audit-demo__recheck { margin-top: 1rem !important; }
  .audit-demo__next { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: clamp(2.5rem, 6vw, 4rem); }
  .audit-demo__next > div { max-width: 68ch; }
  .audit-demo__next p:not(.eyebrow) { margin-bottom: 0; }
  @media (max-width: 700px) {
    .audit-demo__summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .audit-demo__cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .audit-demo__metadata > div { grid-template-columns: 1fr; gap: .1rem; }
    .audit-demo__comparison { grid-template-columns: 1fr; }
  }
</style>
