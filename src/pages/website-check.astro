---
import BaseLayout from '../layouts/BaseLayout.astro';
import sample from '../data/audit-sample.json';

const evidenceCardCount = [sample.finding, sample.residual].filter(Boolean).length;
---

<BaseLayout
  title="Website Check — LDW-owned evidence proof"
  description="A precomputed LDW-owned example showing how Lowcountry Digital Works can explain one accepted technical finding, its recheck, and a provider-controlled residual limitation. This page does not scan websites."
  noindex
>
  <div class="audit-demo">
    <section class="audit-demo__hero" aria-labelledby="audit-title">
      <div class="container audit-demo__hero-inner">
        <p class="audit-demo__label">{sample.label}</p>
        <h1 id="audit-title">See how LDW turns evidence into a bounded decision.</h1>
        <p class="audit-demo__lede">This proof uses one accepted LDW-owned technical evidence cycle to show the before observation, bounded action, same-source recheck, and what remained outside LDW control.</p>
        <p class="audit-demo__notice">
          <strong>This page does not scan a website.</strong> It displays precomputed evidence from an already accepted LDW-owned cycle. No domain is requested, no provider is contacted, and no live check runs from this page.
        </p>
      </div>
    </section>

    <section class="container audit-demo__section" aria-labelledby="sample-state-title">
      <div class="audit-demo__section-heading">
        <div>
          <p class="eyebrow">Evidence state</p>
          <h2 id="sample-state-title">Accepted LDW evidence — no scan is running.</h2>
        </div>
        <p class="audit-demo__state">{sample.fixtureState}</p>
      </div>

      <p class="audit-demo__state-copy">The browser experience is rendering a saved, publication-safe evidence fixture. It has no live progress, provider request, current-domain result, or automatic recheck.</p>

      <dl class="audit-demo__summary" aria-label="Evidence coverage summary">
        <div><dt>Evidence records</dt><dd>{evidenceCardCount}</dd></div>
        <div><dt>Live checks from this page</dt><dd>0</dd></div>
        <div><dt>Provider requests from this page</dt><dd>0</dd></div>
        <div><dt>Evidence state</dt><dd>{sample.fixtureState}</dd></div>
      </dl>
      <p class="audit-demo__coverage"><strong>Coverage:</strong> {sample.coverage}.</p>
    </section>

    <section class="audit-demo__findings" aria-labelledby="findings-title">
      <div class="container">
        <div class="audit-demo__section-heading audit-demo__findings-heading">
          <div>
            <p class="eyebrow">Accepted evidence</p>
            <h2 id="findings-title">What changed, and what did not become our claim</h2>
          </div>
          <p class="audit-demo__coverage">Source: {sample.source}</p>
        </div>

        <div class="audit-demo__cards">
          <article class="audit-demo__card" aria-labelledby={`${sample.finding.id}-title`} data-evidence-id={sample.finding.id}>
            <div class="audit-demo__card-top">
              <p class="audit-demo__category">{sample.finding.category}</p>
              <p class="audit-demo__tag">Action owner: {sample.finding.owner}</p>
            </div>
            <h3 id={`${sample.finding.id}-title`}>{sample.finding.title}</h3>
            <p class="audit-demo__summary-text">{sample.finding.summary}</p>

            <div class="audit-demo__comparison" aria-label="Accepted before and recheck observations from the same source">
              <div>
                <h4>Before observation</h4>
                <p class="audit-demo__metric">{sample.finding.beforeCount}</p>
                <p><code>{sample.finding.id}</code> findings</p>
              </div>
              <div>
                <h4>Recheck observation</h4>
                <p class="audit-demo__metric">{sample.finding.afterCount}</p>
                <p><code>{sample.finding.id}</code> finding</p>
              </div>
            </div>

            <details class="audit-demo__details">
              <summary>View measured evidence and context</summary>
              <div class="audit-demo__details-body">
                <dl class="audit-demo__metadata">
                  <div><dt>Source</dt><dd>{sample.source}</dd></div>
                  <div><dt>Evidence cycle</dt><dd>{sample.evidenceCycle}</dd></div>
                  <div><dt>Freshness</dt><dd>{sample.freshness}</dd></div>
                  <div><dt>Coverage</dt><dd>{sample.coverage}.</dd></div>
                  <div><dt>Action ownership</dt><dd>{sample.finding.owner}</dd></div>
                </dl>

                <h4>What the evidence means</h4>
                <p>{sample.finding.meaning}</p>

                <h4>Bounded action</h4>
                <p>{sample.finding.action}</p>

                <h4>Verification path</h4>
                <p>{sample.finding.verification}</p>

                <p class="audit-demo__recheck"><strong>Recheck:</strong> {sample.finding.recheck}</p>
              </div>
            </details>
          </article>

          <article class="audit-demo__card audit-demo__card--residual" aria-labelledby={`${sample.residual.id}-title`} data-evidence-id={sample.residual.id}>
            <div class="audit-demo__card-top">
              <p class="audit-demo__category">{sample.residual.category}</p>
              <p class="audit-demo__tag">{sample.residual.status}</p>
            </div>
            <h3 id={`${sample.residual.id}-title`}>{sample.residual.title}</h3>
            <p class="audit-demo__summary-text">{sample.residual.summary}</p>
            <dl class="audit-demo__metadata audit-demo__metadata--compact">
              <div><dt>Ownership</dt><dd>{sample.residual.owner}</dd></div>
              <div><dt>Decision</dt><dd>{sample.residual.status}</dd></div>
            </dl>
            <p class="audit-demo__limitation"><strong>Limitation:</strong> {sample.residual.limitation}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="container audit-demo__section" aria-labelledby="not-measured-title">
      <div class="audit-demo__section-heading">
        <div>
          <p class="eyebrow">Claim boundary</p>
          <h2 id="not-measured-title">What this proof does not measure</h2>
        </div>
      </div>
      <p class="audit-demo__state-copy">{sample.claimBoundary}</p>
      <ul class="audit-demo__not-measured">
        {sample.notMeasured.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="container audit-demo__next" aria-labelledby="next-title">
      <div>
        <p class="eyebrow">A useful next step</p>
        <h2 id="next-title">Want to talk through a real website?</h2>
        <p>This LDW-owned proof is not a result for your business. If you want to discuss a real review, share what you are trying to understand and LDW can help define a suitable, separately authorized next step.</p>
      </div>
      <a class="button" href="/discovery/">Start a project conversation <span aria-hidden="true">→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .audit-demo { color: var(--text); }
  .audit-demo__hero { padding: clamp(3.25rem, 8vw, 6rem) 0 3rem; background: var(--surface-warm); }
  .audit-demo__hero-inner { max-width: 820px; }
  .audit-demo__label { display: inline-block; margin: 0 0 1rem; padding: .35rem .7rem; border: 2px solid var(--interactive); border-radius: var(--radius-sm); font-size: .82rem; font-weight: 800; letter-spacing: .08em; }
  .audit-demo h1 { max-width: 18ch; margin: 0; font-size: clamp(2.2rem, 6vw, 4.3rem); line-height: 1.08; }
  .audit-demo__lede { max-width: 62ch; margin: 1.2rem 0; font-size: clamp(1.1rem, 2.3vw, 1.35rem); }
  .audit-demo__notice { max-width: 70ch; margin: 1.5rem 0 0; padding: 1rem 1.15rem; border-left: 4px solid var(--interactive); background: var(--surface); }
  .audit-demo__section { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .audit-demo__section-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; }
  .audit-demo__section-heading h2, .audit-demo__next h2 { margin: 0; font-size: clamp(1.55rem, 3vw, 2.2rem); line-height: 1.2; }
  .audit-demo__state { margin: 0; padding: .45rem .75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); font-weight: 750; }
  .audit-demo__state-copy { max-width: 72ch; color: var(--muted); }
  .audit-demo__summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin: 1.5rem 0 0; }
  .audit-demo__summary > div { min-width: 0; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  .audit-demo__summary dt { color: var(--muted); font-size: .88rem; }
  .audit-demo__summary dd { margin: .25rem 0 0; font-size: 1.1rem; font-weight: 800; overflow-wrap: anywhere; }
  .audit-demo__coverage { max-width: 58ch; margin: 1rem 0 0; color: var(--muted); }
  .audit-demo__findings { padding-block: clamp(2.5rem, 6vw, 4rem); background: var(--surface); }
  .audit-demo__findings-heading { margin-bottom: 1.5rem; }
  .audit-demo__findings-heading .audit-demo__coverage { margin: 0; }
  .audit-demo__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .audit-demo__card { min-width: 0; padding: clamp(1.15rem, 3vw, 1.7rem); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg); }
  .audit-demo__card--residual { border-style: dashed; }
  .audit-demo__card-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; }
  .audit-demo__category, .audit-demo__tag { margin: 0; font-size: .84rem; font-weight: 750; }
  .audit-demo__tag { padding: .2rem .5rem; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .audit-demo__card h3 { margin: 1rem 0 .5rem; font-size: 1.35rem; line-height: 1.25; }
  .audit-demo__summary-text { margin: 0 0 1.2rem; }
  .audit-demo__details { border-top: 1px solid var(--border); margin-top: 1rem; }
  .audit-demo__details summary { padding: .9rem 0 .15rem; color: var(--interactive); font-weight: 750; text-decoration: underline; text-underline-offset: .18em; cursor: pointer; }
  .audit-demo__details-body { padding-top: .75rem; }
  .audit-demo__details-body h4 { margin: 1.25rem 0 .25rem; font-size: 1rem; }
  .audit-demo__details-body p { margin: .25rem 0; }
  .audit-demo__metadata { display: grid; gap: .6rem; margin: 0; }
  .audit-demo__metadata > div { display: grid; grid-template-columns: minmax(7.5rem, .35fr) minmax(0, 1fr); gap: .6rem; }
  .audit-demo__metadata dt { font-weight: 750; }
  .audit-demo__metadata dd { margin: 0; overflow-wrap: anywhere; }
  .audit-demo__metadata--compact { margin-top: 1rem; }
  .audit-demo__comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: 1rem; }
  .audit-demo__comparison > div { min-width: 0; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  .audit-demo__comparison h4 { margin: 0 0 .35rem; font-size: 1rem; }
  .audit-demo__comparison p { margin: .2rem 0; }
  .audit-demo__metric { font-size: clamp(1.8rem, 5vw, 2.7rem); font-weight: 850; line-height: 1; }
  .audit-demo__recheck { margin-top: 1rem !important; }
  .audit-demo__limitation { margin: 1.25rem 0 0; padding: .9rem 1rem; border-left: 4px solid var(--interactive); background: var(--surface); }
  .audit-demo__not-measured { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; max-width: 760px; margin: 1.25rem 0 0; padding: 0; list-style: none; }
  .audit-demo__not-measured li { min-width: 0; padding: .8rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  .audit-demo__next { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: clamp(2.5rem, 6vw, 4rem); }
  .audit-demo__next > div { max-width: 68ch; }
  .audit-demo__next p:not(.eyebrow) { margin-bottom: 0; }
  @media (max-width: 700px) {
    .audit-demo__summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .audit-demo__cards, .audit-demo__not-measured { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .audit-demo__metadata > div { grid-template-columns: 1fr; gap: .1rem; }
    .audit-demo__comparison { grid-template-columns: 1fr; }
  }
</style>
