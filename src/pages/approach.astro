---
import BaseLayout from '../layouts/BaseLayout.astro';
import approach from '../data/approach.json';
---
<BaseLayout title="Approach" description="A practical Assess, Build, Handoff approach focused on maintainability, ownership, accessibility, security, and clear documentation.">
  <section class="page-hero"><div class="container readable"><p class="eyebrow">{approach.hero.eyebrow}</p><h1>{approach.hero.title}</h1><p class="lede">{approach.hero.lede}</p></div></section>

  <section class="section"><div class="container"><div class="flow">{approach.steps.map((step) => <article class="flow__step"><h2>{step.title}</h2><p>{step.description}</p></article>)}</div></div></section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">{approach.beforeBuild.eyebrow}</p><h2>{approach.beforeBuild.title}</h2></div>
      <div class="grid grid--2">{approach.beforeBuild.items.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
    </div>
  </section>

  <section class="section section--navy"><div class="container principle"><div><p class="eyebrow">{approach.principles.eyebrow}</p><h2>{approach.principles.title}</h2></div><ul class="principle__list">{approach.principles.items.map((item) => <li>{item}</li>)}</ul></div></section>

  <section class="section"><div class="container readable"><p class="eyebrow">{approach.handoff.eyebrow}</p><h2>{approach.handoff.title}</h2><p class="lede">{approach.handoff.body}</p><div class="actions"><a class="button" href="/contact/">Discuss a project</a></div></div></section>
</BaseLayout>
