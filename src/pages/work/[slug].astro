---
import BaseLayout from '../../layouts/BaseLayout.astro';
import work from '../../data/work.json';

export function getStaticPaths() {
  return work.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---
<BaseLayout title={project.name} description={project.purpose}>
  <nav class="breadcrumbs" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <div class="container">
      <ol>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/work/"><span itemprop="name">Work</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{project.name}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <section class="page-hero">
    <div class="container readable">
      <div class="work-row__meta">
        <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
        <span>{project.type}</span>
      </div>
      <h1>{project.name}</h1>
      <p class="lede">{project.purpose}</p>
    </div>
  </section>

  <section class="section">
    <div class="container project-detail-grid">
      <div>
        <p class="eyebrow">What it is</p>
        <h2>Purpose before polish.</h2>
        <p class="lede">{project.description}</p>
        {project.externalHref && <div class="actions"><a class="button button--secondary" href={project.externalHref}>View live site</a></div>}
      </div>
      <aside class="project-boundary">
        <p class="eyebrow">Current boundary</p>
        <p>{project.boundary}</p>
      </aside>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Evidence</p><h2>What this work demonstrates.</h2></div>
      <div class="evidence-grid">
        {project.evidence.map((item, index) => <article><span>0{index + 1}</span><p>{item}</p></article>)}
      </div>
      <p class="asset-gap-note">Project screenshots or diagrams will be added only when a real public-safe asset is available; this candidate does not invent visual evidence.</p>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container final-cta final-cta--single">
      <div><p class="eyebrow">Related work</p><h2>Need help with a similar kind of problem?</h2><p>Use the problem as the starting point rather than trying to match a product name.</p></div>
      <div class="actions"><a class="button button--secondary" href="/connect/">Connect with Eddie</a></div>
    </div>
  </section>
</BaseLayout>
