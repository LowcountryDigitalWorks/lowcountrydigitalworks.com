---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';
import Icon from '../../components/Icon.astro';
import serviceDetails from '../../data/service-details.json';
import serviceSearch from '../../data/service-search.json';
import work from '../../data/work.json';
import visuals from '../../data/service-detail-visuals.json';
import careOptions from '../../data/care-options.json';

export function getStaticPaths() {
  return serviceDetails.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const search = serviceSearch[service.slug];
if (!search?.title || !search?.description) throw new Error(`Missing approved search metadata for service: ${service.slug}`);
const page = visuals.pages[service.slug];
const suppressRelated = Boolean(page.suppressRelatedWork);
// Website Care does not carry the G.A.S. Workbench card (Seat 1a 1.2); presentation-only switch, service-details.json stays untouched.
const relatedWork = suppressRelated ? [] : work.projects.filter((project) => service.relatedWork?.includes(project.slug));
const relatedClientWork = work.clientWork.items.filter((client) => service.relatedClientWork?.includes(client.id));
const stage = visuals.stages[service.slug];
const slug = service.slug;
// Build-time only: the provisional Care tiers exist ONLY on this exact Workers Builds preview branch.
// An arbitrary CARE_OPTIONS_PREVIEW=1 never enables them on main or any other branch.
// CARE_OPTIONS_PREVIEW=0 can opt out locally/for QA without relaxing this allowlist.
const careOptionsPreview =
process.env.WORKERS_CI === '1' &&
process.env.WORKERS_CI_BRANCH === 'feature/web-160-coastal-v2c-preview-phaseb-20261109' &&
process.env.CARE_OPTIONS_PREVIEW !== '0';
const showCareOptions = careOptionsPreview && slug === 'website-care';

// Three example outcomes at most; the fourth Websites outcome (maintainable operating model) is already the documentation line in "work".
const outcomes = service.outcomes.slice(0, 3);
const outcomeRail = slug === 'website-care' || slug === 'digital-ownership-platform-administration';
const notIncluded = page.notIncluded;
const [toolProject] = relatedWork;
const clientAssets = {
  'east-coast-foam': '/r5/assets/clients/east-coast-foam-1280',
  'donovan-family-dentistry': '/r5/assets/clients/donovan-family-dentistry-1280',
};
const toolAssets = {
  'document-control': {
    avif: '/r5/assets/internal/document-control-workflow-crop.avif',
    webp: '/r5/assets/internal/document-control-workflow-crop.webp',
    src: '/r5/assets/internal/document-control-workflow-crop.jpg',
    w: 780, h: 422,
    phone: { avif: '/r5/assets/internal/document-control-overview-phone.avif', webp: '/r5/assets/internal/document-control-overview-phone.webp', src: '/r5/assets/internal/document-control-overview-phone.jpg', w: 960, h: 545 },
    alt: 'Document Control workflow screen with synthetic test data.',
  },
  'gas-engine': {
    avif: '/r5/assets/internal/gas-workbench-current.avif',
    webp: '/r5/assets/internal/gas-workbench-current.webp',
    src: '/work-assets/gas-workbench-current.png',
    w: 1440, h: 900,
    alt: 'G.A.S. Workbench synthetic demo screen showing a current-state summary with example data.',
  },
};

---
<BaseLayout title={search.title} description={search.description}>
  <nav class="breadcrumbs" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <div class="container">
      <ol>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/services/"><span itemprop="name">Services</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{service.name}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <article itemscope itemtype="https://schema.org/Service">
    <section class="page-hero page-hero--fit service-detail-hero svc-hero" aria-labelledby="service-detail-heading">
      <div class="container svc-hero__grid">
        <div class="page-hero-plate readable">
          <p class="eyebrow">{service.kicker}</p>
          <h1 id="service-detail-heading" itemprop="name">{service.name}</h1>
          <p class="lede" itemprop="description">{service.summary}</p>
          <div class="actions">
            <a class="text-link" href="#fit">See when this helps ↓</a>
          </div>
          <p class="service-provider">Provided by <a href="/" itemprop="provider" itemscope itemtype="https://schema.org/Organization" itemid="https://lowcountrydigitalworks.com/#organization"><span itemprop="name">Lowcountry Digital Works</span></a></p>
        </div>
        <figure class={`svc-stage svc-stage--${stage.ar}`}>
          <div class="svc-stage__media-wrap">
            <picture>
              <source media="(max-width: 719px)" srcset={`/r5/assets/diagrams/${stage.name}-phone.svg`} width={stage.pw} height={stage.ph} />
              <img class="svc-stage__media" src={`/r5/assets/diagrams/${stage.name}.svg`} alt={stage.alt} width={stage.w} height={stage.h} fetchpriority="high" decoding="async" />
            </picture>
          </div>
          <figcaption class="svc-stage__cap">
            <span class="pill pill--outline">{stage.pill}</span>
            <span>{stage.caption}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section" id="fit" aria-labelledby="fit-heading">
      <div class="container svc-split">
        <div class="svc-split__lead">
          <p class="eyebrow">When this helps</p>
          <h2 id="fit-heading">{page.whoHeading}</h2>
        </div>
        <ol class="svc-rows">
          {service.problems.map((problem, index) => (
            <li class="svc-row">
              <span class="svc-row__n" aria-hidden="true">{index + 1}</span>
              <p class="svc-row__t">{problem}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {slug === 'business-systems-automation' ? (
      <section class="section section--warm" aria-labelledby="included-heading">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">What the work can include</p>
            <h2 id="included-heading">{page.includedHeading}</h2>
            <p class="lede">{page.stepsLead}</p>
          </div>
          <ol class="svc-steps svc-steps--4">
            {service.work.map((item) => <li class="svc-steps__item"><p>{item}</p></li>)}
          </ol>
          <div class="svc-boundary">
            <h3>Not included</h3>
            <ul class="svc-list svc-list--out">{notIncluded.map((item) => <li>{item}</li>)}</ul>
            <p class="svc-ownership"><strong>Ownership boundary.</strong> {service.ownership}</p>
          </div>
        </div>
      </section>
    ) : slug === 'technology-consulting' ? (
      <section class="section section--warm" aria-labelledby="included-heading">
        <div class="container">
          <div class="svc-split svc-split--wide">
            <div>
              <p class="eyebrow">What the work can include</p>
              <h2 id="included-heading">{page.includedHeading}</h2>
              <ul class="svc-list svc-list--in svc-list--lead">
                {service.work.map((item) => <li><Icon name="check" size={18} class="svc-check" /><span>{item}</span></li>)}
              </ul>
            </div>
            <figure class="svc-diagram">
              <picture>
                <source media="(max-width: 719px)" srcset="/r5/assets/diagrams/svc-roadmap-phone.svg" width="360" height="420" />
                <img src="/r5/assets/diagrams/svc-roadmap.svg" alt={page.roadmapAlt} width="680" height="300" loading="lazy" decoding="async" />
              </picture>
              <figcaption><span class="pill pill--outline">Diagram: example setup</span> A consulting path: findings, options, then a bounded roadmap or a decision to leave it alone.</figcaption>
            </figure>
          </div>
          <div class="svc-boundary">
            <h3>Not included</h3>
            <ul class="svc-list svc-list--out">{notIncluded.map((item) => <li>{item}</li>)}</ul>
            <p class="svc-ownership"><strong>Ownership boundary.</strong> {service.ownership}</p>
          </div>
        </div>
      </section>
    ) : (
      <section class="section section--warm" aria-labelledby="included-heading">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">What the work can include</p>
            <h2 id="included-heading">{page.includedHeading}</h2>
          </div>
          <div class="svc-compare">
            <div class="svc-compare__col">
              <h3>Included</h3>
              <ul class="svc-list svc-list--in">
                {service.work.map((item) => <li><Icon name="check" size={18} class="svc-check" /><span>{item}</span></li>)}
              </ul>
            </div>
            <div class="svc-compare__col svc-compare__col--out">
              <h3>Not included</h3>
              <ul class="svc-list svc-list--out">{notIncluded.map((item) => <li>{item}</li>)}</ul>
              <p class="svc-ownership"><strong>Ownership boundary.</strong> {service.ownership}</p>
            </div>
          </div>
          <p class="svc-links">
            {service.guideHref && <a class="text-link" href={service.guideHref}>{service.guideLabel} →</a>}
            {page.includedLink && <a class="text-link" href={page.includedLink.href}>{page.includedLink.label} →</a>}
          </p>
        </div>
      </section>
    )}

    {showCareOptions && (
      <section class="section section--sky care-options" id="care-options" aria-labelledby="care-options-heading" data-care-options-preview>
        <div class="container">
          <p class="care-banner" role="note"><span class="care-banner__tag">{careOptions.statusLabel}</span><span>{careOptions.disclaimer}</span></p>
          <div class="care-options__lead">
            <div>
              <p class="eyebrow">{careOptions.eyebrow}</p>
              <h2 id="care-options-heading">{careOptions.heading}</h2>
              <p class="lede">{careOptions.lede}</p>
              <p class="care-separation">{careOptions.separationNote}</p>
            </div>
            <figure class="care-loopband">
              <div class="care-loopband__crop">
                <picture>
                  <source media="(max-width: 719px)" srcset="/r5/assets/diagrams/svc-care-loop-phone.svg" width="360" height="240" />
                  <img src="/r5/assets/diagrams/svc-care-loop.svg" alt={careOptions.diagram.alt} width="680" height="420" loading="lazy" decoding="async" />
                </picture>
              </div>
              <figcaption><span class="pill pill--outline">{careOptions.diagram.pill}</span> {careOptions.diagram.caption}</figcaption>
            </figure>
          </div>
          <h3 class="care-every__title">{careOptions.sharedHeading}</h3>
          <ul class="care-every">
            {careOptions.shared.map((line) => <li>{line}</li>)}
          </ul>
          <p class="care-jump"><a class="text-link" href={careOptions.jumpHref}>{careOptions.jumpLine} ↓</a></p>
          <ol class="care-main">
            {careOptions.primary.map((option) => (
              <li class:list={['care-card', option.recommended ? 'care-card--rec' : option.optionNumber === 4 ? 'care-card--c' : 'care-card--a']} id={`care-option-${option.optionNumber}`} data-care-option={option.id}>
                <div class="care-badges">
                  <span class="care-chip">Option {option.optionNumber}</span>
                  {option.recommended && <span class="care-badge care-badge--rec">{careOptions.recommendedLabel}</span>}
                  <span class="care-badge care-badge--proposed">{careOptions.proposedLabel}</span>
                </div>
                <h3>{option.job}</h3>
                <p class="care-depth"><span class={`care-sheets care-sheets--${option.sheets}`} aria-hidden="true"><i></i><i></i><i></i><i></i></span><span><strong>{careOptions.reportLabel}:</strong> {option.report}</span></p>
                {option.recommended && <p class="care-caveat">{careOptions.recommendedNote}</p>}
                <div class="care-adds"><h4>{careOptions.addsLabel}</h4><ul class="svc-list svc-list--in">{option.adds.map((item) => <li><Icon name="check" size={18} class="svc-check" /><span>{item}</span></li>)}</ul></div>
                <div class="care-not"><h4>{careOptions.notIncludedLabel}</h4><ul class="svc-list svc-list--out">{option.notIncluded.map((item) => <li>{item}</li>)}</ul></div>
              </li>
            ))}
          </ol>
          <h3 class="care-rows__title">{careOptions.secondaryHeading}</h3>
          <ul class="care-rows">
            {careOptions.secondary.map((option) => (
              <li class:list={['care-row', option.optionNumber === 1 ? 'care-row--light' : 'care-row--tailored']} data-care-option={option.id}>
                <div><span class="care-chip">Option {option.optionNumber}</span> <span class="care-badge">{option.proposedLabel}</span><h4>{option.job}</h4></div>
                <div class="care-row__body">
                  {option.sheets && <p class="care-depth care-depth--row"><span class={`care-sheets care-sheets--${option.sheets}`} aria-hidden="true"><i></i><i></i><i></i><i></i></span><span><strong>{careOptions.reportLabel}:</strong> {option.report}</span></p>}
                  {!option.sheets && <p><strong>{careOptions.reportLabel}:</strong> {option.report}</p>}
                  <p><strong>{careOptions.addsLabel}:</strong> {option.adds.join(' ')}</p>
                  <p><strong>{careOptions.notIncludedLabel}:</strong> {option.notIncluded.join(' ')}</p>
                </div>
              </li>
            ))}
          </ul>
          <p class="care-closing">{careOptions.closingLine}</p>
        </div>
      </section>
    )}

    {outcomes.length > 0 && (
      <section class="section" aria-labelledby="outcomes-heading">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">What a good engagement should leave behind</p>
            <h2 id="outcomes-heading">Useful outcomes, not a bigger technology footprint.</h2>
          </div>
          <ul class:list={['svc-outcomes', outcomeRail && 'svc-outcomes--rail']}>
            {outcomes.map((outcome, index) => (
              <li class="svc-outcomes__item">
                <h3>{outcome.title}</h3>
                <p>{outcome.description}</p>
                <p class="svc-outcomes__ex"><span class="pill pill--outline">Illustrative situation, not a client result</span><span>{page.situations[index]}</span></p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {relatedClientWork.length > 0 && (
      <section class="section section--navy svc-proof" data-related-client-work aria-labelledby="client-proof-heading">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Client work</p>
            <h2 id="client-proof-heading">See the website work in production.</h2>
            <p class="lede">{work.clientWork.lede}</p>
          </div>
          <div class="svc-proof-grid">
            {relatedClientWork.map((client) => (
              <article class="svc-client" data-client-proof={client.id}>
                <a class="svc-client__shot" href={client.href} rel="noopener noreferrer" aria-label={`Live client site: visit ${client.name}`}>
                  <span class="svc-frame">
                    <span class="svc-frame__bar" aria-hidden="true"><span class="svc-frame__dots"></span><span class="svc-frame__label">Live client site</span></span>
                    <picture>
                      <source type="image/avif" srcset={`${clientAssets[client.id]}.avif`} />
                      <source type="image/webp" srcset={`${clientAssets[client.id]}.webp`} />
                      <img src={`${clientAssets[client.id]}.jpg`} alt={client.thumbnail.alt} width={client.thumbnail.width} height={client.thumbnail.height} loading="lazy" decoding="async" />
                    </picture>
                  </span>
                </a>
                <div class="svc-client__body">
                  <div class="work-row__meta">
                    <span class="status-pill status-pill--live">Live client site</span>
                    <span>{client.type}</span>
                  </div>
                  <h3>{client.name}</h3>
                  <p><strong>Live proof:</strong> {client.proof}</p>
                  <p class="svc-client__boundary"><strong>Boundary:</strong> {client.boundary}</p>
                  <a class="text-link text-link--light" href={client.href} rel="noopener noreferrer">Visit live site: {client.name} →</a>
                </div>
              </article>
            ))}
          </div>
          {service.proofNote && <p class="svc-proof__note">{service.proofNote}</p>}
          <p class="portfolio-detail-note"><a class="text-link text-link--light" href="/work/">See full work context & boundaries →</a></p>
        </div>
      </section>
    )}

    {toolProject && (
      <section class="section section--warm svc-proof svc-proof--tool" aria-labelledby="tool-proof-heading">
        <div class="container svc-split svc-split--wide">
          <div class="svc-tool__copy">
            <p class="eyebrow">How LDW applies this</p>
            <h2 id="tool-proof-heading">Evidence before broad claims.</h2>
            {service.proofNote && <p class="lede">{service.proofNote}</p>}
            {relatedWork.map((project) => (
              <div class="svc-tool" data-related-work={project.slug}>
                <div class="work-row__meta">
                  <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
                  <span class="pill pill--outline">Internal tool · synthetic / test-only</span>
                </div>
                <h3>{project.name}</h3>
                <p>{project.cardBoundary}</p>
                <a class="text-link" href={`/work/${project.slug}/`}>View project evidence →</a>
              </div>
            ))}
          </div>
          <figure class="svc-toolframe">
            <div class="svc-toolframe__bar" aria-hidden="true"><span class="svc-frame__dots"></span><span class="svc-frame__label">Internal LDW tool · synthetic data</span></div>
            <picture>
              {toolAssets[toolProject.slug].phone && (
                <>
                  <source media="(max-width: 719px)" type="image/avif" srcset={toolAssets[toolProject.slug].phone.avif} />
                  <source media="(max-width: 719px)" type="image/webp" srcset={toolAssets[toolProject.slug].phone.webp} />
                  <source media="(max-width: 719px)" srcset={toolAssets[toolProject.slug].phone.src} />
                </>
              )}
              <source type="image/avif" srcset={toolAssets[toolProject.slug].avif} />
              <source type="image/webp" srcset={toolAssets[toolProject.slug].webp} />
              <img class="svc-toolframe__shot" src={toolAssets[toolProject.slug].src} alt={toolAssets[toolProject.slug].alt} width={toolAssets[toolProject.slug].w} height={toolAssets[toolProject.slug].h} loading="lazy" decoding="async" />
            </picture>
          </figure>
        </div>
      </section>
    )}

    {slug === 'digital-ownership-platform-administration' && (
      <section class="section section--navy svc-proof" aria-labelledby="keys-heading">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">How LDW applies this</p>
            <h2 id="keys-heading">{page.proofHeading}</h2>
            {service.proofNote && <p class="lede">{service.proofNote}</p>}
          </div>
          <figure class="svc-diagram svc-diagram--keys">
            <picture>
              <source media="(max-width: 719px)" srcset="/r5/assets/diagrams/who-holds-the-keys-phone.svg" width="360" height="460" />
              <img src="/r5/assets/diagrams/who-holds-the-keys.svg" alt="Diagram: example setup — who holds the keys. Domain, DNS, hosting, email and logins all point to the business owner. Illustrative, not a client system." width="960" height="280" loading="lazy" decoding="async" />
            </picture>
            <figcaption><span class="pill pill--outline">Diagram: example setup</span> An illustration of the ownership model, not a client record.</figcaption>
          </figure>
        </div>
      </section>
    )}

    {slug === 'website-care' && (
      <section class="section section--warm svc-proof svc-proof--note" aria-labelledby="care-proof-heading">
        <div class="container svc-split">
          <div class="svc-split__lead">
            <p class="eyebrow">How LDW applies this</p>
            <h2 id="care-proof-heading">Evidence before broad claims.</h2>
          </div>
          <div>
            <p class="lede">{service.proofNote}</p>
            {service.proofHref && <a class="text-link icon-link" href={service.proofHref} rel="noopener"><Icon name="github" size={17} /><span>{service.proofLabel}</span></a>}
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="container">
        <FaqList items={service.faqs} title="Useful answers before you decide what kind of help you need." />
      </div>
    </section>

    <section class="section section--navy section--cta-band svc-cta" aria-labelledby="svc-cta-heading">
      <div class="container svc-cta__inner">
        <div>
          <p class="eyebrow">Next step</p>
          <h2 id="svc-cta-heading">{visuals.ctaHeading}</h2>
          <p class="lede">{visuals.ctaBody}</p>
        </div>
        <div class="actions"><a class="button button--oyster" href="/connect/">{service.cta}</a></div>
      </div>
    </section>
  </article>
</BaseLayout>
