---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';
import serviceDetails from '../../data/service-details.json';
import work from '../../data/work.json';

export function getStaticPaths() {
  return serviceDetails.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const relatedWork = work.projects.filter((project) => service.relatedWork?.includes(project.slug));
---
<BaseLayout title={service.name} description={service.summary}>
  <nav class="breadcrumbs" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <div class="container">
      <ol>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a itemprop="item" href="/services/"><span itemprop="name">Services</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{service.name}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <article itemscope itemtype="https://schema.org/Service">
    <section class="page-hero">
      <div class="container readable">
        <p class="eyebrow">{service.kicker}</p>
        <h1 itemprop="name">{service.name}</h1>
        <p class="lede" itemprop="description">{service.summary}</p>
        <p class="service-provider">Provided by <a href="/" itemprop="provider" itemscope itemtype="https://schema.org/Organization"><span itemprop="name">Lowcountry Digital Works</span></a></p>
      </div>
    </section>

    <section class="section">
      <div class="container service-detail-grid">
        <div>
          <p class="eyebrow">When this helps</p>
          <h2>Start with the friction.</h2>
          <ul class="detail-list">{service.problems.map((problem) => <li>{problem}</li>)}</ul>
        </div>
        <div>
          <p class="eyebrow">What the work can include</p>
          <h2>Use the smallest useful intervention.</h2>
          <ul class="detail-list">{service.work.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section section--navy">
      <div class="container principle">
        <div><p class="eyebrow">Ownership boundary</p><h2>Keep responsibility clear.</h2></div>
        <p class="lede">{service.ownership}</p>
      </div>
    </section>

    {service.proofNote && (
      <section class="section">
        <div class="container proof-callout">
          <div>
            <p class="eyebrow">How LDW applies this</p>
            <h2>Evidence before broad claims.</h2>
          </div>
          <p class="lede">{service.proofNote}</p>
        </div>
      </section>
    )}

    {relatedWork.length > 0 && (
      <section class="section section--warm">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Related work</p>
            <h2>See how the approach shows up in real LDW work.</h2>
          </div>
          <div class="related-work-grid">
            {relatedWork.map((project) => (
              <article class="related-work-card">
                {project.visuals?.[0] && (
                  <a class="related-work-card__visual" href={`/work/${project.slug}/`} aria-label={`View ${project.name} project details`}>
                    <img
                      src={project.visuals[0].src}
                      alt=""
                      width={project.visuals[0].width}
                      height={project.visuals[0].height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                <div class="related-work-card__body">
                  <div class="work-row__meta">
                    <span class={`status-pill ${project.status === 'Live' ? 'status-pill--live' : ''}`}>{project.status}</span>
                    <span>{project.type}</span>
                  </div>
                  <h3>{project.name}</h3>
                  <p>{project.purpose}</p>
                  <a class="text-link" href={`/work/${project.slug}/`}>View project evidence →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="container">
        <FaqList items={service.faqs} title="Useful answers before you decide what kind of help you need." />
      </div>
    </section>

    <section class="section section--warm">
      <div class="container final-cta final-cta--single">
        <div><p class="eyebrow">Next step</p><h2>{service.cta}</h2><p>Start with the current situation and desired outcome. A technical specification is not required.</p></div>
        <div class="actions"><a class="button" href="/connect/">Connect with Eddie</a></div>
      </div>
    </section>
  </article>
</BaseLayout>
