---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const {
  title = 'Lowcountry Digital Works',
  description = 'Practical websites, applications, automation, and technical systems built for maintainability and client ownership.',
  image = '/brand/social/social-card-1200x630.png',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const fullTitle = title === 'Lowcountry Digital Works' ? title : `${title} | Lowcountry Digital Works`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#102A3A" />
  <meta name="color-scheme" content="light" />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url.origin)} />
  <meta name="twitter:card" content="summary_large_image" />
  <title>{fullTitle}</title>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header />
  <main id="main-content"><slot /></main>
  <Footer />
</body>
</html>
