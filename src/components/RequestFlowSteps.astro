---
/**
 * Shared first-contact flow: one source for Connect (all four steps) and Home (three: the
 * optional external form is disclosed on Connect and Discovery, so Home skips step 02).
 * carousel: Connect (2x2 from 900px) and Home (grid=3: three in a row from 900px). Phone = shared scroll-snap carousel with dots.
 */
const { variant = 'connect', layout, carousel = false, id, grid = 2, label = 'How a first note moves' } = Astro.props;
const allSteps = [
  {
    title: 'You send a note',
    body: 'Text, call, or email—or use the guided project form if you want more structure. No passwords or sensitive secrets in ordinary channels.',
  },
  {
    homeSkip: true,
    title: 'Optional external form',
    body: 'Discovery uses a hosted form outside this site. It is not embedded here and is not a contract or quote by itself.',
  },
  {
    title: 'Eddie reviews',
    body: 'A person reads what you sent, checks fit and constraints, and may ask a clarifying question before scoping.',
  },
  {
    title: 'A reply',
    body: 'You hear back by text, call, or email with a sensible next step—often a written scope outline when a project is in view.',
  },
];
const steps = (variant === 'home' ? allSteps.filter((step) => !step.homeSkip) : allSteps).map((step, index) => ({ ...step, num: String(index + 1).padStart(2, '0') }));
---
{carousel ? (
  <div class:list={['carousel carousel--light flow-car', grid === 3 ? 'carousel--grid-3' : 'carousel--grid-2']} id={id} role="region" aria-roledescription="carousel" aria-label={label} data-carousel data-carousel-start="0">
    <div class="carousel__track flow-car__track" role="group" aria-label={`${label}, swipe or use arrow keys`} tabindex="0" data-carousel-track>
      {steps.map((step, index) => (
        <div class="carousel__slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${steps.length}: ${step.title}`} data-carousel-slide>
          <div class="request-flow-steps__card flow-card">
            <p class="request-flow-steps__num flow-card__n" aria-hidden="true">{step.num}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="carousel__dots" data-carousel-dots hidden>
      {steps.map((step, index) => (
        <button type="button" class="carousel__dot" data-carousel-dot aria-label={`Show ${index + 1} of ${steps.length}: ${step.title}`}></button>
      ))}
    </div>
  </div>
) : (
  <div class:list={['request-flow-steps', layout === '2x2' && 'request-flow-steps--2x2', variant === 'home' && 'request-flow-steps--3']} role="list">
    {steps.map((step) => (
      <div class="request-flow-steps__card" role="listitem">
        <p class="request-flow-steps__num" aria-hidden="true">{step.num}</p>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </div>
    ))}
  </div>
)}
