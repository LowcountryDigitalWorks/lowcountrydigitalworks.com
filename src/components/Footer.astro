---
import contact from '../data/contact.json';
---
<footer class="site-footer">
  <div class="container footer-grid" itemscope itemtype="https://schema.org/ProfessionalService">
    <div>
      <a href="/" aria-label="Lowcountry Digital Works home">
        <img class="footer-logo" itemprop="logo" src="/brand/logo/lowcountry-digital-works-logo-horizontal-white.svg" alt="Lowcountry Digital Works" width="312" height="88" />
      </a>
      <p><strong itemprop="name">Lowcountry Digital Works</strong><br />Owner-operated technology work built for maintainability, clear handoff, and customer ownership.</p>
      <p class="small" itemprop="founder" itemscope itemtype="https://schema.org/Person">
        <span itemprop="name">{contact.founder.name}</span> · <span itemprop="jobTitle">{contact.founder.role}</span>
      </p>
    </div>
    <nav aria-label="Footer">
      <a href="/services/">Services</a>
      <a href="/work/">Work</a>
      <a href="/approach/">Approach</a>
      <a href="/about/">About</a>
      <a href="/connect/">Connect</a>
      <a href="/privacy/">Privacy / Website Use</a>
    </nav>
    <div class="footer-contact">
      <p><strong>Contact</strong><br />
        <a itemprop="email" href={`mailto:${contact.email.address}`}>{contact.email.address}</a><br />
        <a itemprop="telephone" href={`tel:${contact.phone.number}`}>{contact.phone.display}</a>
      </p>
      <p class="footer-socials">
        {contact.socials.map((social) => <a itemprop="sameAs" href={social.href} rel="me noopener">{social.name}</a>)}
      </p>
      <meta itemprop="url" content="https://lowcountrydigitalworks.com/" />
      <p class="small">South Carolina Lowcountry · remote work where the fit is right</p>
      <p class="small">© {new Date().getFullYear()} Lowcountry Digital Works.</p>
    </div>
  </div>
</footer>
<style>
.site-footer { padding: 3rem 0; background: var(--ldw-estuary-navy); color: white; }
.footer-grid { display: grid; grid-template-columns: minmax(0,1.5fr) .8fr 1.1fr; gap: 2.5rem; align-items: start; }
.footer-logo { width: min(260px, 100%); }
.site-footer p { max-width: 48ch; color: #d9e4e7; }
.site-footer nav { display: grid; gap: .45rem; }
.site-footer a { color: white; }
.footer-contact { min-width: 0; }
.footer-socials { display: flex; gap: 1rem; flex-wrap: wrap; }
.small { font-size: .88rem; }
@media(max-width:760px){ .footer-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
