---
import contact from '../data/contact.json';
---
<nav class="mobile-contact-bar" aria-label="Quick contact">
  <a href={`sms:${contact.phone.number}`} aria-label={`Text Eddie at ${contact.phone.display}`}>
    <span aria-hidden="true">Text</span>
    <strong>Eddie</strong>
  </a>
  <a href={`tel:${contact.phone.number}`} aria-label={`Call Eddie at ${contact.phone.display}`}>
    <span aria-hidden="true">Call</span>
    <strong>Eddie</strong>
  </a>
</nav>
