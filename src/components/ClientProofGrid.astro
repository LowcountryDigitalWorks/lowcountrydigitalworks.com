---
const { eyebrow, title, lede, items, home = false } = Astro.props;
// Phone-width portrait shots (390x780) in AVIF/WebP; same pixels as /work-assets/clients/*-390.jpg.
const mobileModern = {
  'east-coast-foam': { avif: '/r5/assets/clients/east-coast-foam-390.avif', webp: '/r5/assets/clients/east-coast-foam-390.webp' },
  'donovan-family-dentistry': { avif: '/r5/assets/clients/donovan-family-dentistry-390-portrait.avif', webp: '/r5/assets/clients/donovan-family-dentistry-390-portrait.webp' },
};
---
<section class="section" id="client-work" data-home-client-work={home ? '' : undefined} data-client-work={!home ? '' : undefined}>
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p class="lede">{lede}</p>
    </div>
    <div class="portfolio-grid portfolio-grid--work portfolio-grid--client-proof">
      {items.map((client) => (
        <article class="portfolio-card portfolio-card--work portfolio-card--proof" data-client-proof={home ? client.id : client.name}>
          {client.thumbnail && (
            <a class="portfolio-card__visual" href={client.href} rel="noopener noreferrer" aria-label={`Visit live site: ${client.name}`}>
              {home && client.id ? (
                <picture>
                  {client.thumbnail.srcMobile && (
                    <>
                      <source type="image/avif" media="(max-width: 680px)" srcset={mobileModern[client.id]?.avif} />
                      <source type="image/webp" media="(max-width: 680px)" srcset={mobileModern[client.id]?.webp} />
                      <source media="(max-width: 680px)" srcset={client.thumbnail.srcMobile} />
                    </>
                  )}
                  <source type="image/avif" srcset={`/r5/assets/clients/${client.id}-1280.avif`} />
                  <source type="image/webp" srcset={`/r5/assets/clients/${client.id}-1280.webp`} />
                  <img
                    src={`/r5/assets/clients/${client.id}-1280.jpg`}
                    alt={client.thumbnail.alt}
                    width={client.thumbnail.width}
                    height={client.thumbnail.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              ) : (
                <img
                  src={client.thumbnail.src}
                  srcset={client.thumbnail.srcMobile ? `${client.thumbnail.srcMobile} 390w, ${client.thumbnail.src} 1280w` : undefined}
                  sizes="(max-width: 680px) 100vw, 560px"
                  alt={client.thumbnail.alt}
                  width={client.thumbnail.width}
                  height={client.thumbnail.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </a>
          )}
          <div class="portfolio-card__body">
            <div class="work-row__meta">
              <span class="status-pill status-pill--live">Live client site</span>
              <span>{client.type}</span>
            </div>
            <h3>{client.name}</h3>
            <p class="lede lede--compact">{client.context}</p>
            {!home && (
              <div class="portfolio-card__context">
                <p><strong>LDW work</strong>{client.work}</p>
                <p><strong>Live proof</strong>{client.proof}</p>
                <p class="portfolio-card__boundary"><strong>Boundary</strong>{client.boundary}</p>
              </div>
            )}
            {home && <p><strong>Live proof:</strong> {client.proof}</p>}
            <a class="text-link" href={client.href} rel="noopener noreferrer">{home ? `Visit live site: ${client.name} →` : 'Visit the live site →'}</a>
          </div>
        </article>
      ))}
    </div>
    {home && <p class="portfolio-detail-note"><a class="text-link" href="/work/">See all work →</a></p>}
  </div>
</section>
